---
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import siteData from "../config/site-data.json";

const locations = siteData.locations;
const year = new Date().getFullYear();
const page = siteData.privacyPage;
const adminLocation = locations[0];
---

<Layout
  title={page.meta.title}
  description={page.meta.description}
  hideHeader={true}
>
  <SiteNav alwaysSticky={true} homeLinks={true} showHome={true} />
  <main class="pp-main">
    <div class="pp-container">

      <header class="pp-header">
        <h1 class="pp-title">{page.title}</h1>
        <p class="pp-subtitle">{page.subtitle.replace("{year}", String(year))}</p>
      </header>

      <article class="pp-content">
        {page.sections.map((section) => (
          <section class="pp-section">
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => (
              <p set:html={paragraph} />
            ))}
            {"subsections" in section && section.subsections?.map((sub) => (
              <Fragment>
                <h3>{sub.heading}</h3>
                {sub.paragraphs.map((paragraph) => (
                  <p set:html={paragraph} />
                ))}
              </Fragment>
            ))}
            {"list" in section && section.list && (
              <ul>
                {section.list.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
            {"showAddress" in section && section.showAddress && (
              <address>
                <strong>{siteData.meta.companyName}</strong><br />
                {adminLocation.address}, {adminLocation.postcode} {adminLocation.city}<br />
                {page.phonePrefix} <a href={`tel:${adminLocation.phone.replace(/\s/g, '')}`}>{adminLocation.phone}</a>
              </address>
            )}
          </section>
        ))}
      </article>

    </div>
  </main>
  <SiteFooter homeLinks={true} />
</Layout>

<style>
  .pp-main {
    background: #0c0c0c;
    min-height: 100vh;
    padding-top: 5.5rem;
  }

  .pp-container {
    margin: 0 auto;
    max-width: 820px;
    padding: 2rem 2rem 5rem;
  }

  .pp-header {
    border-bottom: 2px solid var(--color-accent);
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
  }

  .pp-title {
    color: #fff;
    font-family: var(--font-title);
    font-size: clamp(1.5rem, 3.5vw, 2.2rem);
    font-weight: 900;
    letter-spacing: 0.06em;
    margin: 0 0 0.4rem;
    text-transform: uppercase;
  }

  .pp-subtitle {
    color: rgba(255,255,255,0.4);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    margin: 0;
  }

  .pp-content {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .pp-section {
    border-left: 3px solid var(--color-accent);
    padding-left: 1.5rem;
  }

  .pp-section h2 {
    color: #fff;
    font-family: var(--font-title);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    margin-bottom: 0.85rem;
    text-transform: uppercase;
  }

  .pp-section h3 {
    color: var(--color-accent);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    margin: 1rem 0 0.4rem;
    text-transform: uppercase;
  }

  .pp-section p,
  .pp-section address {
    color: rgba(255,255,255,0.7);
    font-size: 0.9rem;
    font-style: normal;
    line-height: 1.75;
    margin: 0 0 0.6rem;
  }

  .pp-section address {
    background: rgba(255,255,255,0.04);
    border-radius: 4px;
    margin-top: 0.5rem;
    padding: 0.85rem 1rem;
  }

  .pp-section ul {
    color: rgba(255,255,255,0.7);
    font-size: 0.9rem;
    line-height: 1.75;
    margin: 0;
    padding-left: 1.5rem;
  }

  .pp-section li {
    margin-bottom: 0.3rem;
  }

  .pp-section a {
    color: var(--color-accent);
    text-decoration: none;
  }
  .pp-section a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pp-section code {
    background: rgba(255,255,255,0.07);
    border-radius: 3px;
    color: rgba(255,255,255,0.85);
    font-size: 0.82rem;
    padding: 0.1em 0.4em;
  }

  @media (max-width: 600px) {
    .pp-container { padding: 1.25rem 1.25rem 4rem; }
    .pp-section { padding-left: 1rem; }
    .pp-main { padding-top: 6rem; }
  }
</style>
