<script is:inline>
(function () {
  /* ---- Sticky nav ---- */
  var barEl   = document.querySelector('.hero-bar');
  var floatFb = document.querySelector('.hero-fb');

  /* Trigger = the Y scroll position at which the bar's top reaches the viewport top.
     barEl.offsetTop is the bar's distance from the top of the document (= CSS top: 100px).
     At scrollY === barEl.offsetTop the bar is flush with the viewport top — perfect moment
     to switch to position:fixed without any visual jump. */
  var triggerY = barEl ? barEl.offsetTop : 100;

  function checkSticky() {
    if (!barEl) return;
    var sticky = window.scrollY >= triggerY;
    barEl.classList.toggle('is-sticky', sticky);
    if (floatFb) floatFb.style.visibility = sticky ? 'hidden' : '';
  }

  window.addEventListener('scroll', checkSticky, { passive: true });
  window.addEventListener('resize', function () {
    if (barEl && !barEl.classList.contains('is-sticky')) triggerY = barEl.offsetTop;
  });
  checkSticky();

  /* ---- Hero tiles → scroll to contact + activate card ---- */
  document.querySelectorAll('.hero-tile[data-loc-id]').forEach(function(tile) {
    tile.addEventListener('click', function(e) {
      e.preventDefault();
      var locId   = tile.dataset.locId;
      var section = document.getElementById('kontakt');
      if (!section) return;
      section.scrollIntoView({ behavior: 'smooth' });
      /* Activate the matching card after scroll settles */
      setTimeout(function() {
        var card = document.querySelector('.contact-card[data-id="' + locId + '"]');
        if (card) card.click();
      }, 700);
    });
  });

  /* ---- Scroll-in animation ---- */
  const slides = document.querySelectorAll('.svc-slide');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        io.unobserve(entry.target);
      });
    }, { threshold: 0.18 });
    slides.forEach(el => io.observe(el));
  } else {
    slides.forEach(el => el.classList.add('is-visible'));
  }

  /* ---- Lightbox ---- */
  const lb      = document.getElementById('lightbox');
  const lbImg   = document.getElementById('lb-img');
  const lbClose = document.getElementById('lb-close');
  const lbPrev  = document.getElementById('lb-prev');
  const lbNext  = document.getElementById('lb-next');

  let gallery = [];
  let idx = 0;

  function open(galleryId, clickedIdx) {
    gallery = [...document.querySelectorAll('[data-gallery="' + galleryId + '"]')]
      .map(b => b.dataset.src);
    idx = clickedIdx;
    lbImg.src = gallery[idx];
    lbImg.alt = document.querySelector('[data-gallery="' + galleryId + '"][data-index="' + clickedIdx + '"] img')?.alt || '';
    lb.hidden = false;
    document.body.style.overflow = 'hidden';
    lbClose.focus();
  }

  function close() {
    lb.hidden = true;
    document.body.style.overflow = '';
  }

  function navigate(dir) {
    idx = (idx + dir + gallery.length) % gallery.length;
    lbImg.src = gallery[idx];
  }

  document.querySelectorAll('.gallery-thumb').forEach(btn => {
    btn.addEventListener('click', () => open(btn.dataset.gallery, +btn.dataset.index));
  });

  lbClose.addEventListener('click', close);
  lbPrev.addEventListener('click', () => navigate(-1));
  lbNext.addEventListener('click', () => navigate(1));
  lb.addEventListener('click', e => { if (e.target === lb) close(); });

  document.addEventListener('keydown', e => {
    if (lb.hidden) return;
    if (e.key === 'Escape')      close();
    if (e.key === 'ArrowLeft')   navigate(-1);
    if (e.key === 'ArrowRight')  navigate(1);
  });
})();
</script>

<script is:inline>
(function () {
  var LOCS = [
    { id: 'jg-powstancow',        lat: 50.9154, lng: 15.7225, city: 'Jelenia Góra',     addr: 'ul. Powstańców Śląskich 41' },
    { id: 'jg-wroclawska',        lat: 50.8978, lng: 15.7472, city: 'Jelenia Góra',     addr: 'ul. Wrocławska 35' },
    { id: 'zabkowice-wroclawska', lat: 50.5903, lng: 16.8134, city: 'Ząbkowice Śląskie', addr: 'ul. Wrocławska 27' }
  ];

  function initMap() {
    var map = L.map('contact-map', { zoomControl: true, scrollWheelZoom: false });

    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; <a href="https://carto.com/">CARTO</a>',
      subdomains: 'abcd',
      maxZoom: 19
    }).addTo(map);

    /* Initial view: fit to JG locations */
    var jgPts = LOCS.filter(function(l) { return l.id !== 'zabkowice-wroclawska'; });
    map.fitBounds(L.latLngBounds(jgPts.map(function(l) { return [l.lat, l.lng]; })), { padding: [50, 50] });

    /* Create markers */
    var markers = {};
    var pinWraps = {};

    LOCS.forEach(function(loc) {
      var wrap = document.createElement('div');
      wrap.className = 'map-pin-wrap';
      wrap.innerHTML = '<div class="map-pin-dot"></div>';
      pinWraps[loc.id] = wrap;

      var icon = L.divIcon({ className: '', html: wrap, iconSize: [22, 22], iconAnchor: [11, 11] });
      var marker = L.marker([loc.lat, loc.lng], { icon: icon })
        .addTo(map)
        .bindPopup('<strong>' + loc.city + '</strong><br>' + loc.addr);
      markers[loc.id] = marker;
    });

    /* Notify Leaflet when container resizes */
    if ('ResizeObserver' in window) {
      new ResizeObserver(function() { map.invalidateSize(); })
        .observe(document.getElementById('contact-map'));
    }

    /* Card click → flyTo */
    document.querySelectorAll('.contact-card').forEach(function(card) {
      card.addEventListener('click', function(e) {
        if (e.target.closest('a')) return;
        var lat = parseFloat(card.dataset.lat);
        var lng = parseFloat(card.dataset.lng);
        var id  = card.dataset.id;

        map.flyTo([lat, lng], 16, { duration: 1.2 });
        if (markers[id]) markers[id].openPopup();

        /* Active state on cards */
        document.querySelectorAll('.contact-card').forEach(function(c) { c.classList.remove('is-active'); });
        card.classList.add('is-active');

        /* Active state on pins */
        Object.values(pinWraps).forEach(function(w) { w.classList.remove('is-active'); });
        if (pinWraps[id]) pinWraps[id].classList.add('is-active');
      });

      card.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); card.click(); }
      });
    });
  }

  /* Load Leaflet dynamically */
  var css = document.createElement('link');
  css.rel = 'stylesheet';
  css.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
  document.head.appendChild(css);

  var js = document.createElement('script');
  js.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
  js.onload = initMap;
  document.head.appendChild(js);
})();
</script>
