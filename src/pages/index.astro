---
import Layout from "../layouts/Layout.astro";
import { locations, siteConfig } from "../config/site";
import { services } from "../config/services";

const iconMap: Record<string, string> = {
  scrap: "/icons/recycle.webp",
  fuel: "/icons/fire.webp",
  hoses: "/icons/pipe.webp",
  catalysts: "/icons/cat.webp",
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      name: siteConfig.companyName,
      url: siteConfig.siteUrl,
      logo: `${siteConfig.siteUrl}/alniko.webp`,
      sameAs: [siteConfig.social.facebook],
      description:
        "ALNIKO: skład i sprzedaż opału, skup złomu, zakuwanie węży hydraulicznych oraz skup katalizatorów.",
    },
    ...locations.map((location) => ({
      "@type": "LocalBusiness",
      name: `${siteConfig.companyName} - ${location.title}`,
      url: siteConfig.siteUrl,
      telephone: location.phoneLabel,
      address: {
        "@type": "PostalAddress",
        streetAddress: location.address,
      },
    })),
  ],
};
---

<Layout
  title="ALNIKO - skład opału, skup złomu, zakuwanie węży hydraulicznych, skup katalizatorów"
  description="ALNIKO działa w Jeleniej Górze i Ząbkowicach Śląskich: skup złomu, skład opału, zakuwanie węży hydraulicznych i skup katalizatorów."
>
  <main>
    <section class="hero" aria-label="Nagłówek strony firmy ALNIKO">
      <img src="/head2.webp" alt="ALNIKO - główna grafika przedstawiająca działalność firmy" width="1920" height="700" />
      <canvas class="hero-dots" aria-hidden="true"></canvas>
      <div class="hero-content">
        <img class="hero-logo" src="/alniko.webp" alt="ALNIKO" width="280" height="90" />
        <div class="hero-tiles">
          {services.map((service) => (
            <a class="hero-tile" href={service.path} style={`--tile-color: ${service.color};`}>
              <span class="hero-tile-inner">
                <span class="hero-tile-bg" />
                <img class="hero-icon" src={iconMap[service.slug]} alt="" width="64" height="64" />
              </span>
              <span class="hero-tile-label">{service.heroLabel}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="container">
      <h2 id="o-nas" class="section-title">O nas</h2>
      <p>
        ALNIKO to lokalna firma obsługująca klientów indywidualnych i biznesowych. Łączymy skup surowców wtórnych,
        sprzedaż opału oraz szybkie zakuwanie węży hydraulicznych w kilku punktach na Dolnym Śląsku.
      </p>
    </section>

    <section class="container">
      <h2 class="section-title">Nasze działalności</h2>
      <div class="service-grid">
        {
          services.map((service) => (
            <a class="service-card" href={service.path} style={`--service-color: ${service.color};`}>
              <h3>{service.name}</h3>
              <span>Zobacz szczegóły</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="container">
      <h2 class="section-title">Lokalizacje</h2>
      <div class="location-grid">
        {
          locations.map((location) => (
            <article class="location-card">
              <h3>{location.title}</h3>
              <p>{location.address}</p>
              <p>
                Tel: <a href={location.phoneHref}>{location.phoneLabel}</a>
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="container">
      <h2 class="section-title">Mapa lokalizacji</h2>
      <div class="map-placeholder">
        <p>Miejsce na mapę z lokalizacjami firmy (sekcja przygotowana pod dalsze doprecyzowanie).</p>
      </div>
    </section>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Layout>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.hero-dots');
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const DOT_COLOR = '0,0,0';       // RGB kolor kropek — zmień np. na '236,127,36' (accent) lub '255,255,255' (białe)
    const DOT_ALPHA_MIN = 0.6;       // przezroczystość bazowa (0–1)
    const DOT_ALPHA_MAX = 0.8;      // przezroczystość przy odsunięciu (0–1)
    const GAP = 6;
    const BASE_R = 3;
    const PUSH_RADIUS = 120;
    const PUSH_STRENGTH = 8;
    const LERP = 0.08;

    let mouse = { x: -9999, y: -9999 };
    let cols = 0;
    let rows = 0;

    interface Dot { bx: number; by: number; dx: number; dy: number }
    let dots: Dot[] = [];

    function resize() {
      const rect = canvas!.getBoundingClientRect();
      canvas!.width = rect.width * devicePixelRatio;
      canvas!.height = rect.height * devicePixelRatio;
      ctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);

      cols = Math.ceil(rect.width / GAP) + 1;
      rows = Math.ceil(rect.height / GAP) + 1;
      dots = [];
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          dots.push({ bx: c * GAP, by: r * GAP, dx: 0, dy: 0 });
        }
      }
    }

    function draw() {
      const w = canvas!.getBoundingClientRect().width;
      const h = canvas!.getBoundingClientRect().height;
      ctx.clearRect(0, 0, w, h);

      for (const dot of dots) {
        const diffX = dot.bx + dot.dx - mouse.x;
        const diffY = dot.by + dot.dy - mouse.y;
        const dist = Math.sqrt(diffX * diffX + diffY * diffY);

        let targetDx = 0;
        let targetDy = 0;

        if (dist < PUSH_RADIUS && dist > 0) {
          const force = (1 - dist / PUSH_RADIUS) * PUSH_STRENGTH;
          targetDx = (diffX / dist) * force;
          targetDy = (diffY / dist) * force;
        }

        dot.dx += (targetDx - dot.dx) * LERP;
        dot.dy += (targetDy - dot.dy) * LERP;

        const x = dot.bx + dot.dx;
        const y = dot.by + dot.dy;
        const displacement = Math.sqrt(dot.dx * dot.dx + dot.dy * dot.dy);
        const alpha = 0.3 + Math.min(displacement / PUSH_STRENGTH, 1) * 0.35;

        ctx.beginPath();
        ctx.arc(x, y, BASE_R, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(0,0,0,${alpha})`;
        ctx.fill();
      }

      requestAnimationFrame(draw);
    }

    const hero = canvas!.closest('.hero')!;
    hero.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = canvas!.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
    });

    hero.addEventListener('mouseleave', () => {
      mouse.x = -9999;
      mouse.y = -9999;
    });

    resize();
    window.addEventListener('resize', resize);
    requestAnimationFrame(draw);
  }
</script>

<style>
  .hero {
    height: 100vh;
    margin-bottom: 2rem;
    position: relative;
  }

  .hero > img {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .hero-content {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: 2.4rem;
    left: 50%;
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
  }

  .hero-dots {
    height: 100%;
    left: 0;
    pointer-events: none;
    position: absolute;
    top: 0;
    width: 100%;
    z-index: 1;
  }

  .hero-logo {
    filter: drop-shadow(0 4px 20px rgb(0 0 0 / 0.5));
    height: auto;
    max-width: 280px;
    position: relative;
    width: 100%;
    z-index: 1;
  }

  .hero-tiles {
    display: flex;
    flex-direction: row;
    gap: 24px;
    position: relative;
    z-index: 1;
  }

  .hero-tile {
    align-items: center;
    color: var(--color-white);
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    position: relative;
    text-decoration: none;
    width: 200px;
  }

  .hero-tile-inner {
    align-items: center;
    aspect-ratio: 1 / 1.15;
    display: flex;
    justify-content: center;
    padding: 1rem;
    position: relative;
    width: 100%;
  }

  .hero-tile-bg {
    background: var(--tile-color);
    display: block;
    inset: 0;
    position: absolute;
    transform: skewX(-8deg);
    transition: filter 0.25s ease, transform 0.25s ease;
  }

  .hero-tile:hover .hero-tile-bg {
    filter: brightness(1.18);
    transform: skewX(-8deg) scaleY(1.04);
  }

  .hero-icon {
    flex-shrink: 0;
    height: 70%;
    object-fit: contain;
    position: relative;
    width: 70%;
    z-index: 1;
  }

  .hero-tile-label {
    font-family: var(--font-title);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    position: relative;
    text-align: center;
    text-shadow: 0 2px 6px rgb(0 0 0 / 0.6);
    text-transform: uppercase;
    z-index: 1;
  }

  @media (max-width: 1100px) {
    .hero-tile {
      width: 150px;
    }

    .hero-tile-label {
      font-size: 0.9rem;
    }
  }

  @media (max-width: 680px) {
    .hero-content {
      gap: 1.4rem;
    }

    .hero-backdrop {
      inset: -1.2rem -1rem;
    }

    .hero-logo {
      max-width: 180px;
    }

    .hero-tiles {
      gap: 12px;
    }

    .hero-tile {
      width: 100px;
    }

    .hero-tile-inner {
      padding: 0.6rem;
    }

    .hero-tile-label {
      font-size: 0.65rem;
    }
  }

  .container {
    margin: 0 auto 2.4rem;
    max-width: 1100px;
    padding: 0 1rem;
  }

  .service-grid {
    display: grid;
    gap: 0.9rem;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  }

  .service-card {
    background: linear-gradient(140deg, var(--service-color), color-mix(in srgb, var(--service-color), black 30%));
    border-radius: 0.4rem;
    color: var(--color-white);
    display: block;
    padding: 1.1rem;
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .service-card:hover {
    transform: translateY(-4px);
  }

  .service-card h3 {
    margin: 0;
  }

  .service-card span {
    display: inline-block;
    margin-top: 0.9rem;
  }

  .location-grid {
    display: grid;
    gap: 0.9rem;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  }

  .location-card {
    border: 1px solid color-mix(in srgb, var(--color-white), transparent 70%);
    border-radius: 0.4rem;
    padding: 1rem;
  }

  .location-card h3 {
    margin-top: 0;
  }

  .location-card a {
    color: var(--color-accent);
    font-weight: 700;
    text-decoration: none;
  }

  .map-placeholder {
    border: 2px dashed color-mix(in srgb, var(--color-accent), transparent 20%);
    border-radius: 0.4rem;
    min-height: 260px;
    padding: 1rem;
  }
</style>
