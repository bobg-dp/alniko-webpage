<script is:inline data-astro-rerun>
(function () {
  if (!document.querySelector('.hero') || !document.getElementById('lightbox')) return;
  if (window.__alnikoHomeAbort) window.__alnikoHomeAbort.abort();
  var ac = new AbortController();
  window.__alnikoHomeAbort = ac;
  var listen = { signal: ac.signal, passive: true };

  /* ---- Sticky nav ---- */
  var barEl   = document.querySelector('.hero-bar');
  var floatFb = document.querySelector('.hero-fb');

  /* Trigger = the Y scroll position at which the bar's top reaches the viewport top.
     barEl.offsetTop is the bar's distance from the top of the document (= CSS top: 100px).
     At scrollY === barEl.offsetTop the bar is flush with the viewport top — perfect moment
     to switch to position:fixed without any visual jump. */
  var triggerY = barEl ? barEl.offsetTop : 100;

  function checkSticky() {
    if (!barEl) return;
    var sticky = window.scrollY >= triggerY;
    barEl.classList.toggle('is-sticky', sticky);
    if (floatFb) floatFb.style.visibility = sticky ? 'hidden' : '';
  }

  window.addEventListener('scroll', checkSticky, listen);
  window.addEventListener('resize', function () {
    if (barEl && !barEl.classList.contains('is-sticky')) triggerY = barEl.offsetTop;
  }, { signal: ac.signal });
  checkSticky();

  /* ---- Hero tiles → scroll to contact + activate card ---- */
  document.querySelectorAll('.hero-tile[data-loc-id]').forEach(function(tile) {
    tile.addEventListener('click', function(e) {
      e.preventDefault();
      var locId   = tile.dataset.locId;
      var section = document.getElementById('kontakt');
      if (!section) return;
      section.scrollIntoView({ behavior: 'smooth' });
      /* Activate the matching card after scroll settles */
      setTimeout(function() {
        var card = document.querySelector('.contact-card[data-id="' + locId + '"]');
        if (card) card.click();
      }, 700);
    });
  });

  /* ---- Stats counters ---- */
  (function () {
    var nums = document.querySelectorAll('.stat-num[data-target]');
    if (!nums.length) return;
    var done = false;

    function animateCounters() {
      if (done) return;
      done = true;
      nums.forEach(function (el) {
        var from     = parseFloat(el.dataset.from || '0');
        var to       = parseFloat(el.dataset.target);
        var decimals = parseInt(el.dataset.decimals || '0', 10);
        var dur      = 1600;
        var start    = null;

        function step(ts) {
          if (!start) start = ts;
          var progress = Math.min((ts - start) / dur, 1);
          var ease = 1 - Math.pow(1 - progress, 3);
          var val  = from + (to - from) * ease;
          el.textContent = decimals ? val.toFixed(decimals) : Math.round(val).toString();
          if (progress < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      });
    }

    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        if (entries[0].isIntersecting) { animateCounters(); io.disconnect(); }
      }, { threshold: 0.5 });
      io.observe(document.querySelector('.stats-section'));
    } else {
      animateCounters();
    }
  })();

  /* ---- Testimonials carousel ---- */
  (function () {
    var items = document.querySelectorAll('.testi-item');
    var dots  = document.querySelectorAll('.testi-dot');
    if (!items.length) return;
    var current = 0;

    function show(idx) {
      items[current].classList.remove('is-active');
      dots[current].classList.remove('is-active');
      current = (idx + items.length) % items.length;
      items[current].classList.add('is-active');
      dots[current].classList.add('is-active');
    }

    dots.forEach(function (dot, i) {
      dot.addEventListener('click', function () { show(i); clearInterval(timer); timer = setInterval(next, 6000); });
    });

    function next() { show(current + 1); }
    var timer = setInterval(next, 6000);
    ac.signal.addEventListener('abort', function () { clearInterval(timer); });
  })();

  /* ---- Scroll-in animation ---- */
  const slides = document.querySelectorAll('.svc-slide');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        io.unobserve(entry.target);
      });
    }, { threshold: 0.18 });
    slides.forEach(el => io.observe(el));
  } else {
    slides.forEach(el => el.classList.add('is-visible'));
  }

  /* ---- Lightbox ---- */
  const lb        = document.getElementById('lightbox');
  const lbImg     = document.getElementById('lb-img');
  const lbCaption = document.getElementById('lb-caption');
  const lbClose   = document.getElementById('lb-close');
  const lbPrev    = document.getElementById('lb-prev');
  const lbNext    = document.getElementById('lb-next');

  let gallery = [];
  let galleryId = '';
  let idx = 0;
  let isAnimating = false;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function getThumb(gId, i) {
    return document.querySelector('[data-gallery="' + gId + '"][data-index="' + i + '"]');
  }

  function updateSlide() {
    const btn = getThumb(galleryId, idx);
    lbImg.src = gallery[idx];
    lbImg.alt = btn?.querySelector('img')?.alt || '';
    if (lbCaption) lbCaption.textContent = btn?.dataset.caption || '';
  }

  function animateFromThumb(thumbBtn) {
    const thumbImg = thumbBtn?.querySelector('img');
    if (!thumbImg || reduceMotion) return;

    const run = () => {
      const start = thumbImg.getBoundingClientRect();
      const end = lbImg.getBoundingClientRect();
      if (!end.width || !end.height) return;

      const dx = (start.left + start.width / 2) - (end.left + end.width / 2);
      const dy = (start.top + start.height / 2) - (end.top + end.height / 2);
      const scale = Math.max(start.width / end.width, start.height / end.height);

      lbImg.style.transition = 'none';
      lbImg.style.transform = 'translate(' + dx + 'px, ' + dy + 'px) scale(' + scale + ')';
      lbImg.getBoundingClientRect(); // force reflow

      requestAnimationFrame(() => {
        lbImg.style.transition = 'transform 0.48s cubic-bezier(0.22, 1, 0.36, 1)';
        lbImg.style.transform = '';
      });
    };

    if (lbImg.complete) {
      requestAnimationFrame(run);
    } else {
      lbImg.addEventListener('load', () => requestAnimationFrame(run), { once: true });
    }
  }

  function open(gId, clickedIdx) {
    if (isAnimating) return;
    galleryId = gId;
    gallery = [...document.querySelectorAll('[data-gallery="' + gId + '"]')]
      .map(b => b.dataset.src);
    idx = clickedIdx;
    updateSlide();

    const thumbBtn = getThumb(gId, clickedIdx);
    lb.hidden = false;
    lb.classList.remove('is-closing');
    document.body.style.overflow = 'hidden';

    requestAnimationFrame(() => {
      lb.classList.add('is-open');
      animateFromThumb(thumbBtn);
      lbClose.focus();
    });
  }

  function close() {
    if (lb.hidden || isAnimating) return;
    isAnimating = true;
    lb.classList.add('is-closing');
    lb.classList.remove('is-open');

    const finish = () => {
      lb.hidden = true;
      lb.classList.remove('is-closing');
      lbImg.style.transition = '';
      lbImg.style.transform = '';
      document.body.style.overflow = '';
      isAnimating = false;
    };

    if (reduceMotion) {
      finish();
      return;
    }

    let done = false;
    const safeFinish = () => {
      if (done) return;
      done = true;
      finish();
    };

    lb.addEventListener('transitionend', function onEnd(e) {
      if (e.target !== lb || e.propertyName !== 'opacity') return;
      lb.removeEventListener('transitionend', onEnd);
      safeFinish();
    });
    window.setTimeout(safeFinish, 450);
  }

  function navigate(dir) {
    if (isAnimating) return;
    idx = (idx + dir + gallery.length) % gallery.length;

    if (reduceMotion) {
      updateSlide();
      return;
    }

    lbImg.classList.add('is-fading');
    window.setTimeout(() => {
      updateSlide();
      const reveal = () => lbImg.classList.remove('is-fading');
      if (lbImg.complete) reveal();
      else lbImg.addEventListener('load', reveal, { once: true });
    }, 140);
  }

  document.querySelectorAll('.gallery-thumb').forEach(btn => {
    btn.addEventListener('click', () => open(btn.dataset.gallery, +btn.dataset.index));
  });

  lbClose.addEventListener('click', close);
  lbPrev.addEventListener('click', () => navigate(-1));
  lbNext.addEventListener('click', () => navigate(1));
  lb.addEventListener('click', e => { if (e.target === lb) close(); });

  document.addEventListener('keydown', e => {
    if (lb.hidden) return;
    if (e.key === 'Escape')      close();
    if (e.key === 'ArrowLeft')   navigate(-1);
    if (e.key === 'ArrowRight')  navigate(1);
  }, { signal: ac.signal });
})();
</script>

<script is:inline data-astro-rerun set:html={`
(function () {
  var mapEl = document.getElementById('contact-map');
  if (!mapEl) return;
  var LOCS = ${mapLocsJson};

  function initMap() {
    if (!document.getElementById('contact-map')) return;
    if (window.__alnikoMap) {
      try { window.__alnikoMap.remove(); } catch (e) {}
      window.__alnikoMap = null;
    }
    var map = L.map('contact-map', { zoomControl: true, scrollWheelZoom: false });
    window.__alnikoMap = map;


    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      maxZoom: 19
    }).addTo(map);

    /* Initial view: fit to JG locations */
    var jgPts = LOCS.filter(function(l) { return l.id !== 'zabkowice-wroclawska'; });
    map.fitBounds(L.latLngBounds(jgPts.map(function(l) { return [l.lat, l.lng]; })), { padding: [50, 50] });

    /* Create markers */
    var markers = {};
    var pinWraps = {};

    LOCS.forEach(function(loc) {
      var wrap = document.createElement('div');
      wrap.className = 'map-pin-wrap';
      wrap.innerHTML = '<div class="map-pin-dot"></div>';
      pinWraps[loc.id] = wrap;

      var icon = L.divIcon({ className: '', html: wrap, iconSize: [22, 22], iconAnchor: [11, 11] });
      var marker = L.marker([loc.lat, loc.lng], { icon: icon })
        .addTo(map)
        .bindPopup('<strong>' + loc.city + '</strong><br>' + loc.addr);
      markers[loc.id] = marker;
    });

    /* Notify Leaflet when container resizes */
    if ('ResizeObserver' in window) {
      new ResizeObserver(function() { map.invalidateSize(); })
        .observe(document.getElementById('contact-map'));
    }

    /* Card click → flyTo */
    document.querySelectorAll('.contact-card').forEach(function(card) {
      card.addEventListener('click', function(e) {
        if (e.target.closest('a')) return;
        var lat = parseFloat(card.dataset.lat);
        var lng = parseFloat(card.dataset.lng);
        var id  = card.dataset.id;

        map.flyTo([lat, lng], 16, { duration: 1.2 });
        if (markers[id]) markers[id].openPopup();

        /* Active state on cards */
        document.querySelectorAll('.contact-card').forEach(function(c) { c.classList.remove('is-active'); });
        card.classList.add('is-active');

        /* Active state on pins */
        Object.values(pinWraps).forEach(function(w) { w.classList.remove('is-active'); });
        if (pinWraps[id]) pinWraps[id].classList.add('is-active');
      });

      card.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); card.click(); }
      });
    });
  }

  /* Load Leaflet dynamically (once) */
  if (window.L) {
    initMap();
    return;
  }
  if (!document.querySelector('link[data-alniko-leaflet]')) {
    var css = document.createElement('link');
    css.rel = 'stylesheet';
    css.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
    css.setAttribute('data-alniko-leaflet', '1');
    document.head.appendChild(css);
  }
  if (!document.querySelector('script[data-alniko-leaflet]')) {
    var js = document.createElement('script');
    js.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
    js.setAttribute('data-alniko-leaflet', '1');
    js.onload = initMap;
    document.head.appendChild(js);
  } else {
    var existing = document.querySelector('script[data-alniko-leaflet]');
    if (window.L) initMap();
    else existing.addEventListener('load', initMap, { once: true });
  }
})();
`} />
