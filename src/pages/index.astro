---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../config/site";
import { services } from "../config/services";
import { Icon } from "astro-icon/components";
import siteData from "../config/site-data.json";

const content = siteData.homePage;
---

<Layout
  title="ALNIKO - skład opału, skup złomu, zakuwanie węży hydraulicznych, skup katalizatorów"
  description="ALNIKO działa w Jeleniej Górze i Ząbkowicach Śląskich: skup złomu, skład opału, zakuwanie węży hydraulicznych i skup katalizatorów."
  hideHeader={true}
  hideFooter={true}
>
  <main>
    <section class="hero-accordion" aria-label="ALNIKO — działalności firmy">
      <img class="accordion-logo" src="/alniko.webp" alt="ALNIKO" width="200" height="65" />

      <div class="accordion-panel panel-intro is-active" data-panel="intro">
        <div class="panel-inner">
          <div class="panel-content">
            <img class="intro-logo" src="/alniko.webp" alt="ALNIKO" width="280" height="90" />
            <p class="panel-tagline" set:html={content.intro.tagline} />
            <h1 class="panel-heading">{content.intro.heading}</h1>
            <div class="panel-body">
              {content.intro.body.map(p => <p set:html={p} />)}
            </div>
            <p class="intro-features-heading" set:html={content.intro.featuresHeading} />
            <ul class="intro-features">
              {content.intro.features.map(f => (
                <li>
                  <Icon name={f.icon} class="feature-icon" aria-hidden="true" />
                  <span set:html={f.text} />
                </li>
              ))}
            </ul>
          </div>
          <a class="panel-contact-link intro-cta" href={content.intro.ctaHref}>
            <span set:html={content.intro.ctaLabel} />
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <span class="panel-label panel-label-intro">
            O Nas
          </span>
        </div>
      </div>

      {services.map((service) => (
        <div
          class="accordion-panel panel-service"
          data-panel={service.slug}
          style={`--panel-color: ${service.color};`}
        >
          <img class="panel-bg" src={service.panelBg} alt="" />
          <div class="panel-overlay" />
          <div class="panel-inner">
            <div class="panel-content">
              <h2 class="panel-title">{service.name}</h2>
              <p class="panel-text" set:html={service.description} />
              <a class="panel-link" href={service.path}>
                <span set:html={service.ctaLabel} />
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
            <span class="panel-label" set:html={service.shortName.split(' ').join('<br>')} />
          </div>
        </div>
      ))}
    </section>
  </main>

  <!-- Mobile promotions FAB + overlay -->
  <button class="promo-fab" id="promo-fab" aria-label="Aktualne promocje">
    <Icon name="lucide:tag" class="promo-fab-icon" aria-hidden="true" />
    <span class="promo-fab-label">Aktualne Promocje</span>
  </button>

  <div class="promo-overlay" id="promo-overlay" aria-modal="true" role="dialog" aria-label="Aktualne promocje">
    <button class="promo-close" id="promo-close" aria-label="Zamknij">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
        <path d="M4 4l14 14M18 4L4 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
      </svg>
    </button>
    <div class="promo-overlay-inner">
      <h2 class="promo-overlay-heading" set:html={content.intro.featuresHeading} />
      <ul class="promo-overlay-list">
        {content.intro.features.map(f => (
          <li>
            <Icon name={f.icon} class="promo-overlay-icon" aria-hidden="true" />
            <span set:html={f.text} />
          </li>
        ))}
      </ul>
    </div>
  </div>
</Layout>

<script>
  const panels = document.querySelectorAll<HTMLDivElement>('.accordion-panel');

  const accordion = document.querySelector<HTMLElement>('.hero-accordion');

  function updateAccordionState() {
    const activePanel = document.querySelector<HTMLElement>('.accordion-panel.is-active');
    if (accordion && activePanel) {
      accordion.dataset.active = activePanel.dataset.panel ?? '';
    }
  }

  panels.forEach(panel => {
    panel.addEventListener('click', () => {
      if (panel.classList.contains('is-active')) return;
      panels.forEach(p => p.classList.remove('is-active'));
      panel.classList.add('is-active');
      updateAccordionState();
    });
  });

  updateAccordionState();

  // --- Promo FAB / overlay ---
  const promoFab = document.getElementById('promo-fab');
  const promoOverlay = document.getElementById('promo-overlay');
  const promoClose = document.getElementById('promo-close');

  function openPromo() {
    promoOverlay?.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }

  function closePromo() {
    promoOverlay?.classList.remove('is-open');
    document.body.style.overflow = '';
  }

  promoFab?.addEventListener('click', openPromo);
  promoClose?.addEventListener('click', closePromo);

  promoOverlay?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closePromo();
  });
</script>

<style>
  .hero-accordion {
    display: flex;
    height: 100vh;
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  .accordion-panel {
    cursor: pointer;
    flex: 1;
    overflow: hidden;
    position: relative;
    transition: flex 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .accordion-panel.is-active {
    flex: 3;
  }

  .panel-intro.is-active {
    flex: 3;
  }

  .accordion-panel::before {
    content: '';
    inset: 0;
    position: absolute;
    z-index: 2;
    background: linear-gradient(to right,
      transparent 0%,
      transparent calc(100% - 3px),
      rgba(255, 255, 255, 0.08) calc(100% - 2px),
      transparent 100%
    );
    pointer-events: none;
  }

  /* Skew edges via clip-path */
  .accordion-panel:not(:first-child) {
    margin-left: -60px;
    clip-path: polygon(60px 0, 100% 0, 100% 100%, 0 100%);
  }

  .accordion-panel:not(:last-child) {
    clip-path: polygon(0 0, 100% 0, calc(100% - 60px) 100%, 0 100%);
  }

  .accordion-panel:not(:first-child):not(:last-child) {
    clip-path: polygon(60px 0, 100% 0, calc(100% - 60px) 100%, 0 100%);
  }

  /* --- Intro Panel --- */

  .panel-intro {
    --panel-color: #ffffff;
    background: #ffffff;
    padding-left: 50px;
  }

  .panel-intro .panel-inner {
    justify-content: space-between;
    padding: 2rem 1.5rem 2rem;
  }

  .panel-intro .panel-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin: auto 0;
    max-width: none;
    opacity: 0;
    padding: 0;
    pointer-events: none;
    transform: translateY(12px);
    transition: opacity 0.12s ease 0s, transform 0.12s ease 0s;
  }

  .panel-intro.is-active .panel-content {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
    transition: opacity 0.4s ease 0.35s, transform 0.4s ease 0.35s;
  }

  .intro-logo {
    display: block;
    height: auto;
    margin: 0 auto;
    max-width: 340px;
    width: 100%;
  }

  .intro-cta {
    flex-shrink: 0;
    opacity: 0;
    pointer-events: none;
    transform: translateY(10px);
    transition: opacity 0.12s ease 0s, transform 0.12s ease 0s;
  }

  .panel-intro.is-active .intro-cta {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
    transition: opacity 0.4s ease 0.45s, transform 0.4s ease 0.45s;
  }

  .intro-features-heading {
    color: var(--color-accent);
    filter: drop-shadow(0 1px 4px rgba(236, 127, 36, 0.45));
    font-family: var(--font-title);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    margin: 0.75rem 0 0.5rem;
    max-width: none;
    text-transform: uppercase;
  }

  .intro-features {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: left;
  }

  .intro-features li {
    align-items: flex-start;
    color: #444;
    display: flex;
    font-size: 0.82rem;
    gap: 0.75rem;
    line-height: 1.5;
  }

  .feature-icon {
    color: var(--color-accent);
    flex-shrink: 0;
    height: 28px;
    margin-top: 0.05rem;
    width: 28px;
  }

  .intro-features strong {
    color: var(--color-accent);
  }

  .accordion-logo {
    height: auto;
    left: 1.5rem;
    max-width: 180px;
    opacity: 1;
    pointer-events: none;
    position: absolute;
    top: 1.5rem;
    transform: translateY(0);
    transition: opacity 0.5s ease, transform 0.5s ease;
    width: 100%;
    z-index: 10;
  }

  .hero-accordion[data-active="intro"] .accordion-logo {
    opacity: 0;
    pointer-events: none;
    transform: translateY(-8px);
  }


  .panel-tagline {
    color: var(--color-accent);
    font-family: var(--font-title);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.5;
    margin: 0;
    max-width: none;
    text-transform: uppercase;
  }

  .panel-heading {
    color: var(--color-bg-dark);
    font-size: 1.1rem;
    margin: 0;
  }

  .panel-body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .panel-body p {
    color: #333;
    font-size: 0.85rem;
    line-height: 1.6;
    margin: 0;
    max-width: 460px;
  }

  .panel-body a {
    color: var(--color-accent);
    font-weight: 700;
    text-decoration: none;
  }

  .panel-body strong {
    color: var(--color-bg-dark);
  }

  .panel-contact-link {
    align-items: center;
    background: var(--color-bg-dark);
    color: var(--color-white);
    display: inline-flex;
    flex-shrink: 0;
    font-size: 0.85rem;
    font-weight: 600;
    gap: 0.5rem;
    margin-top: 0.5rem;
    padding: 0.6rem 1.2rem;
    text-decoration: none;
    transform: skewX(-4deg);
    transition: filter 0.2s ease, transform 0.2s ease;
  }

  .panel-contact-link:hover {
    filter: brightness(1.4);
    transform: skewX(-4deg) scale(1.05);
  }

  /* --- Service Panels --- */

  .panel-service {
    background: var(--panel-color);
  }

  .panel-bg {
    height: 100%;
    inset: 0;
    object-fit: cover;
    object-position: center;
    position: absolute;
    width: 100%;
    z-index: 0;
  }

  .panel-overlay {
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--panel-color), transparent 40%) 0%,
      color-mix(in srgb, var(--panel-color), black 30%) 100%
    );
    inset: 0;
    position: absolute;
    z-index: 1;
    transition: opacity 0.6s ease;
  }

  .accordion-panel.is-active .panel-overlay {
    opacity: 0.7;
  }

  .panel-service:not(.is-active) .panel-overlay {
    opacity: 0.85;
  }

  /* --- Panel Inner (shared) --- */

  .panel-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    justify-content: flex-end;
    padding: 2rem 1.5rem;
    position: relative;
    z-index: 3;
  }

  .panel-label {
    color: var(--color-white);
    font-family: var(--font-title);
    font-size: 0.8rem;
    font-weight: 700;
    left: 50%;
    letter-spacing: 0.06em;
    line-height: 1.6;
    opacity: 1;
    padding: 0 0.5rem;
    position: absolute;
    text-align: center;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
    text-transform: uppercase;
    top: 50%;
    transform: translate(-50%, -50%);
    transition: opacity 0.4s ease 0.35s;
    width: 100%;
  }

  .accordion-panel.is-active .panel-label {
    opacity: 0;
    transition: opacity 0.12s ease 0s;
  }

  /* --- Panel Content (expanded state) --- */

  .accordion-panel .panel-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 500px;
    opacity: 0;
    padding: 0 1rem;
    pointer-events: none;
    transform: translateY(12px);
    transition: opacity 0.12s ease 0s, transform 0.12s ease 0s;
  }

  .accordion-panel.is-active .panel-content {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
    transition: opacity 0.4s ease 0.35s, transform 0.4s ease 0.35s;
  }

  .panel-intro .panel-label {
    color: var(--color-bg-dark);
  }

  .panel-title {
    color: var(--color-white);
    font-size: 1.6rem;
    margin: 0;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
  }

  .panel-text {
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  .panel-link {
    align-items: center;
    background: var(--panel-color);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--color-white);
    display: inline-flex;
    font-size: 0.85rem;
    font-weight: 600;
    gap: 0.5rem;
    margin-top: 0.5rem;
    padding: 0.6rem 1.2rem;
    text-decoration: none;
    transform: skewX(-4deg);
    transition: filter 0.2s ease, transform 0.2s ease;
  }

  .panel-link:hover {
    filter: brightness(1.3);
    transform: skewX(-4deg) scale(1.05);
  }

  /* --- Responsive --- */

  @media (max-width: 900px) {
    .accordion-panel:not(:first-child) {
      margin-left: -22px;
      clip-path: polygon(22px 0, 100% 0, 100% 100%, 0 100%);
    }

    .accordion-panel:not(:last-child) {
      clip-path: polygon(0 0, 100% 0, calc(100% - 22px) 100%, 0 100%);
    }

    .accordion-panel:not(:first-child):not(:last-child) {
      clip-path: polygon(22px 0, 100% 0, calc(100% - 22px) 100%, 0 100%);
    }

    .panel-title {
      font-size: 1.3rem;
    }
  }

  @media (max-width: 680px) {
    .hero-accordion {
      flex-direction: column;
      height: 100vh;
    }

    .accordion-panel:not(:first-child) {
      clip-path: polygon(0 15px, 100% 0, 100% 100%, 0 100%);
      margin-left: 0;
      margin-top: -15px;
    }

    .accordion-panel:not(:last-child) {
      clip-path: polygon(0 0, 100% 0, 100% calc(100% - 15px), 0 100%);
    }

    .accordion-panel:not(:first-child):not(:last-child) {
      clip-path: polygon(0 15px, 100% 0, 100% calc(100% - 15px), 0 100%);
    }

    .accordion-panel.is-active {
      flex: 8;
    }

    .panel-intro.is-active {
      flex: 8;
    }

    .panel-intro {
      min-height: 100px;
      padding-left: 0;
    }

    .panel-intro .panel-label {
      display: none;
    }

    .panel-label {
      font-size: 0.65rem;
    }

    .panel-inner {
      padding: 1rem 1rem 2rem;
    }

    .panel-intro .panel-content {
      padding: 1.5rem 1rem;
    }

    .intro-logo {
      max-width: 160px;
    }

    /* Hide in-panel promotions on mobile */
    .intro-features-heading,
    .intro-features {
      display: none;
    }
  }

  /* --- Promo FAB (mobile only) --- */

  .promo-fab {
    align-items: center;
    background: var(--color-accent);
    border: none;
    border-radius: 999px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
    color: #fff;
    cursor: pointer;
    display: none;
    font-size: 0.78rem;
    font-weight: 700;
    gap: 0.4rem;
    letter-spacing: 0.03em;
    padding: 0.6rem 1.1rem 0.6rem 0.85rem;
    position: fixed;
    right: 1.25rem;
    top: 1rem;
    text-transform: uppercase;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    z-index: 200;
  }

  .promo-fab:hover {
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.45);
    transform: scale(1.06);
  }

  .promo-fab-icon {
    height: 18px;
    width: 18px;
  }

  @media (max-width: 680px) {
    .promo-fab {
      display: flex;
    }
  }

  /* --- Promo overlay --- */

  .promo-overlay {
    background: var(--color-bg-dark);
    clip-path: circle(0% at calc(100% - 2.75rem) 2.75rem);
    color: #fff;
    display: flex;
    flex-direction: column;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    position: fixed;
    transition: clip-path 0.55s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 300;
  }

  .promo-overlay.is-open {
    clip-path: circle(160% at calc(100% - 2.75rem) 2.75rem);
    pointer-events: auto;
  }

  .promo-close {
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.65);
    cursor: pointer;
    padding: 1.25rem;
    position: absolute;
    right: 0;
    top: 0;
    transition: color 0.2s ease;
    z-index: 1;
  }

  .promo-close:hover {
    color: #fff;
  }

  .promo-overlay-inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    height: 100%;
    justify-content: center;
    opacity: 0;
    padding: 3rem 2rem;
    transform: translateY(16px);
    transition: opacity 0.3s ease 0.1s, transform 0.3s ease 0.1s;
  }

  .promo-overlay.is-open .promo-overlay-inner {
    opacity: 1;
    transform: translateY(0);
  }

  .promo-overlay-heading {
    color: var(--color-accent);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .promo-overlay-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .promo-overlay-list li {
    align-items: flex-start;
    display: flex;
    font-size: 1.05rem;
    gap: 1rem;
    line-height: 1.55;
  }

  .promo-overlay-icon {
    color: var(--color-accent);
    flex-shrink: 0;
    height: 28px;
    margin-top: 0.1em;
    width: 28px;
  }
</style>
