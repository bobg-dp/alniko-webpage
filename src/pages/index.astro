---
import Layout from "../layouts/Layout.astro";
import { services, serviceMap } from "../config/services";
import siteData from "../config/site-data.json";

const allLocations = siteData.locations;

function locsForService(slug: string) {
  return allLocations.filter(loc => (loc.services as string[]).includes(slug));
}

const locationStyles: Record<string, { bg: string; color: string }> = {
  "jg-powstancow":        { bg: "/panel-fuel.png",       color: "#ec7f24" },
  "jg-wroclawska":        { bg: "/panel-catalysts.png",  color: "#efba1c" },
  "zabkowice-wroclawska": { bg: "/panel-scrap.png",      color: "#646464" },
};
---

<Layout
  title="ALNIKO - skład opału, skup złomu, zakuwanie węży hydraulicznych, skup katalizatorów"
  description="ALNIKO działa w Jeleniej Górze i Ząbkowicach Śląskich: skup złomu, skład opału, zakuwanie węży hydraulicznych i skup katalizatorów."
  hideHeader={true}
  hideFooter={true}
>
  <main>
    <section class="hero" aria-label="ALNIKO">

      <!-- Slideshow -->
      <div class="slideshow">
        {services.map((service, i) => (
          <div
            class="slide"
            style={`--slide-bg: url('${service.panelBg}'); animation-delay: ${i * 5}s;`}
          >
            <div class="slide-title-wrap">
              <h2 class="slide-title">{service.name}</h2>
            </div>
          </div>
        ))}
      </div>

      <!-- Overlay gradient -->
      <div class="hero-overlay" aria-hidden="true" />

      <!-- Header bar -->
      <div class="hero-bar">
        <a href="/" class="hero-bar-brand">
          <img src="/alniko.webp" alt="ALNIKO" class="hero-bar-logo" width="180" height="58" />
        </a>
        <nav class="hero-bar-nav" aria-label="Nawigacja główna">
          <a href="#lokalizacje">Nasze lokalizacje</a>
          <a href="#o-nas">O nas</a>
          <a href="/kontakt">Kontakt</a>
        </nav>
      </div>

      <!-- Facebook icon (outside bar, right side) -->
      <a
        href="https://www.facebook.com/opalalniko"
        class="hero-fb"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ALNIKO na Facebooku"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
        </svg>
      </a>

      <!-- Location tiles (bottom) -->
      <div class="hero-tiles" id="lokalizacje">
        {allLocations.map((loc, i) => {
          const style = locationStyles[loc.id] ?? { bg: "/panel-scrap.png", color: "#646464" };
          return (
            <a
              href={`https://www.google.com/maps/dir/?api=1&destination=${loc.lat},${loc.lng}`}
              class="hero-tile"
              style={`--tile-color: ${style.color}; --tile-bg: url('${style.bg}'); animation-delay: ${0.3 + i * 0.22}s;`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${loc.city}, ${loc.address}`}
            >
              <span class="tile-city">{loc.city}</span>
              <span class="tile-address">{loc.postcode} {loc.address}</span>
              <div class="tile-svcs">
                {(loc.services as string[]).map(slug => {
                  const svc = serviceMap[slug as keyof typeof serviceMap];
                  return svc ? (
                    <span class="tile-svc-tag" style={`--tag-color: ${svc.color};`}>{svc.shortName}</span>
                  ) : null;
                })}
              </div>
            </a>
          );
        })}
      </div>

    </section>

    <!-- O nas -->
    <section id="o-nas" class="about-section">
      <div class="about-container">

        <div class="about-header">
          <a href="/">
            <img src="/alniko.webp" alt="Alniko Skład Opału Jelenia Góra" class="about-logo" />
          </a>
        </div>

        <div class="about-main">

          <div class="about-awards">
            <a href="https://www.orlyhandlu.pl/profile-362918-cmp/" target="_blank" rel="noopener noreferrer" class="award-link" aria-label="Orły Handlu 2025 – Laureat Konkursu">
              <img src="https://www.orlyhandlu.pl/images/projectImages/app_logo_for_customer_2025_240.png" alt="Orły Handlu 2025 – Laureat Konkursu" class="award-img" />
            </a>
            <a href="https://www.orlyhandlu.pl/profile-362918-cmp/" target="_blank" rel="noopener noreferrer" class="award-link" aria-label="Orły Handlu – Laureat Plebiscytu">
              <img src="https://www.orlyhandlu.pl/images/medals/laureat300_black_2_pl.png" alt="Orły Handlu – Laureat Plebiscytu" class="award-img" />
            </a>
            <a href="https://www.orlyhandlu.pl/profile-362918-cmp/" target="_blank" rel="noopener noreferrer" class="award-link" aria-label="Orły Handlu 2021 – Laureat Konkursu">
              <img src="http://opal.alniko.eu/thumbs/handlu-2021-logo-1500-3.jpg" alt="Orły Handlu 2021 – Laureat Konkursu" class="award-img" />
            </a>
          </div>

          <div class="about-body">
            <p class="about-tagline">Niech komfort ogrzewania będzie lepszy!<br/>Najwyższa jakość w najniższej cenie!</p>
            <p>Jesteśmy składem węgla w Jeleniej Górze otwartym od 2018 roku, naszym celem jest zapewnienie klientom najlepszej jakości opału w najniższej cenie.</p>
            <p>Chcemy się rozwijać i poszerzać nasz asortyment o produkty, których Państwo szukają. Jesteśmy chętni do współpracy z klientem i szybkiej realizacji usług.</p>
            <p>Oferujemy transport zakupionego towaru we wskazane miejsce o umówionej porze dnia. Szczegóły dotyczące transportu znajdują się w zakładce oferta.</p>
            <p>Jesteśmy dostępni dla Państwa drogą e-mail, jak i na portalu społecznościowym <a href="https://www.facebook.com/opalalniko" target="_blank" rel="noopener noreferrer">Facebook.com&nbsp;@opalalniko</a> poprzez który można się z nami kontaktować i liczyć na szybką odpowiedź oraz pod numerem telefonu <a href="tel:519411866">519&nbsp;411&nbsp;866</a>.</p>
            <p>Staramy się dbać nie tylko o jakość produktów, ale także o najlepszy i niezawodny kontakt z klientem, który jest dla Nas jak złoto.</p>
          </div>

        </div>

      </div>
    </section>

  </main>
</Layout>

<style>
  /* ---- Reset & base ---- */
  * { box-sizing: border-box; margin: 0; padding: 0; }

  /* ---- Hero ---- */
  .hero {
    height: 100vh;
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  /* ---- Slideshow ---- */
  .slideshow {
    height: 100%;
    inset: 0;
    position: absolute;
    width: 100%;
  }

  .slide {
    animation: slide-show 20s infinite;
    animation-fill-mode: backwards;
    display: flex;
    flex-direction: column;
    inset: 0;
    opacity: 0;
    overflow: hidden;
    position: absolute;
    transition: none;
    z-index: 0;
  }

  /* Background lives here so Ken Burns doesn't affect content */
  .slide::before {
    animation: kb-zoom-in 14s ease-in-out infinite alternate;
    background-image: var(--slide-bg);
    background-position: center;
    background-size: cover;
    content: '';
    inset: -4%;
    position: absolute;
    z-index: 0;
  }

  .slide:nth-child(2)::before {
    animation-name: kb-pan-right;
    animation-duration: 18s;
  }

  .slide:nth-child(3)::before {
    animation-name: kb-zoom-out;
    animation-duration: 12s;
  }

  .slide:nth-child(4)::before {
    animation-name: kb-drift-left;
    animation-duration: 16s;
  }

  @keyframes kb-zoom-in {
    from { transform: scale(1); }
    to   { transform: scale(1.06); }
  }

  @keyframes kb-pan-right {
    from { transform: scale(1.04) translateX(-1.5%); }
    to   { transform: scale(1.04) translateX(1.5%); }
  }

  @keyframes kb-zoom-out {
    from { transform: scale(1.06); }
    to   { transform: scale(1); }
  }

  @keyframes kb-drift-left {
    from { transform: scale(1.04) translateX(1.5%); }
    to   { transform: scale(1.04) translateX(-1.5%); }
  }

  @keyframes slide-show {
    0%   { opacity: 0; }
    8%   { opacity: 1; }
    25%  { opacity: 1; }
    33%  { opacity: 0; }
    100% { opacity: 0; }
  }

  /* ---- Slide content ---- */

  .slide-title-wrap {
    align-items: center;
    display: flex;
    flex: 1;
    justify-content: center;
    padding: 6rem 5vw 20%;
    position: relative;
    z-index: 1;
  }

  .slide-title {
    color: #fff;
    font-size: clamp(2.2rem, 4.3vw, 3.9rem);
    font-weight: 900;
    letter-spacing: 0.06em;
    line-height: 1.1;
    margin: 0;
    text-align: center;
    text-shadow: 0 2px 28px rgba(0, 0, 0, 0.75);
    text-transform: uppercase;
  }

  .slide-locs { display: none; }

  /* ---- Overlay ---- */
  .hero-overlay {
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.35) 0%,
      rgba(0, 0, 0, 0.15) 55%,
      rgba(0, 0, 0, 0.55) 100%
    );
    inset: 0;
    position: absolute;
    z-index: 1;
  }

  /* ---- Header bar ---- */
  .hero-bar {
    align-items: center;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.18);
    display: flex;
    gap: 2rem;
    height: 80px;
    left: 0;
    padding: 0 2.5rem;
    position: absolute;
    top: 100px;
    width: 75%;
    z-index: 10;
  }

  .hero-bar-brand {
    flex-shrink: 0;
    line-height: 0;
  }

  .hero-bar-logo {
    height: 46px;
    object-fit: contain;
    width: auto;
  }

  .hero-bar-nav {
    align-items: center;
    display: flex;
    flex: 1;
    gap: 2rem;
    justify-content: center;
  }

  .hero-bar-nav a {
    color: #1a1a1a;
    font-family: var(--font-title);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }

  .hero-bar-nav a:hover {
    color: var(--color-accent);
  }

  /* Facebook icon — outside bar, right side */
  .hero-fb {
    color: #fff;
    line-height: 0;
    position: absolute;
    right: 20px;
    top: 100px;
    transform: translateY(calc(80px / 2 - 13px)); /* vertically center with bar */
    transition: color 0.2s ease, transform 0.2s ease;
    z-index: 11;
  }

  .hero-fb:hover {
    color: #e0e0e0;
    transform: translateY(calc(80px / 2 - 13px)) scale(1.15);
  }

  /* ---- Service tiles ---- */
  .hero-tiles {
    bottom: 0;
    display: flex;
    height: 25%;
    left: 0;
    position: absolute;
    width: 100%;
    z-index: 5;
  }

  @keyframes tile-fadein {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-tile {
    align-items: center;
    animation: tile-fadein 0.65s ease forwards;
    background-image: var(--tile-bg);
    background-position: center;
    background-size: cover;
    clip-path: polygon(16px 0%, 100% 0%, calc(100% - 16px) 100%, 0% 100%);
    color: #fff;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.85rem;
    justify-content: center;
    opacity: 0;
    overflow: hidden;
    padding: 1.5rem 1.5rem;
    position: relative;
    text-decoration: none;
    transition: transform 0.3s ease;
  }

  /* Overlap to close gaps */
  .hero-tile:not(:first-child) {
    margin-left: -16px;
  }

  /* Stacking: each tile on top of the previous */
  .hero-tile:nth-child(1) { z-index: 1; }
  .hero-tile:nth-child(2) { z-index: 2; }
  .hero-tile:nth-child(3) { z-index: 3; }

  /* First tile: straight left edge */
  .hero-tile:first-child {
    clip-path: polygon(0 0%, 100% 0%, calc(100% - 16px) 100%, 0% 100%);
  }

  /* Last tile: straight right edge */
  .hero-tile:last-child {
    clip-path: polygon(16px 0%, 100% 0%, 100% 100%, 0% 100%);
  }

  /* Color overlay */
  .hero-tile::before {
    background: color-mix(in srgb, var(--tile-color), black 30%);
    content: '';
    inset: 0;
    opacity: 0.88;
    position: absolute;
    transition: opacity 0.3s ease;
    z-index: 0;
  }

  /* Top shimmer line */
  .hero-tile::after {
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.22), transparent);
    content: '';
    height: 1px;
    left: 0;
    position: absolute;
    top: 0;
    transform: scaleX(0);
    transition: transform 0.4s ease;
    width: 100%;
    z-index: 1;
  }

  .hero-tile:hover {
    transform: translateY(-6px);
    z-index: 10;
  }

  .hero-tile:hover::before {
    opacity: 0.65;
  }

  .hero-tile:hover::after {
    transform: scaleX(1);
  }

  .hero-tile > * {
    position: relative;
    z-index: 1;
  }

  .tile-city {
    font-family: var(--font-title);
    font-size: clamp(1rem, 1.6vw, 1.4rem);
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1.1;
    text-align: center;
    text-shadow: 0 2px 10px rgba(0,0,0,0.65);
    text-transform: uppercase;
  }

  .tile-address {
    font-size: clamp(0.68rem, 1vw, 0.88rem);
    font-weight: 500;
    letter-spacing: 0.03em;
    opacity: 0.88;
    text-align: center;
    text-shadow: 0 1px 6px rgba(0,0,0,0.55);
  }

  .tile-svcs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    justify-content: center;
    margin-top: 0.15rem;
  }

  .tile-svc-tag {
    background: color-mix(in srgb, var(--tag-color) 55%, transparent);
    border: 1px solid color-mix(in srgb, var(--tag-color) 75%, white 25%);
    clip-path: polygon(0 0, calc(100% - 6px) 0, 100% 6px, 100% 100%, 6px 100%, 0 calc(100% - 6px));
    font-size: clamp(0.58rem, 0.85vw, 0.72rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.55rem;
    text-align: center;
    text-shadow: 0 1px 4px rgba(0,0,0,0.4);
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .hero-bar {
      height: 68px;
      top: 60px;
      width: 90%;
    }

    .hero-bar-nav {
      gap: 1.25rem;
    }

    .hero-bar-nav a {
      font-size: 0.62rem;
    }
  }

  @media (max-width: 680px) {
    .hero-bar {
      gap: 1rem;
      height: 58px;
      padding: 0 1.25rem;
      top: 40px;
      width: 100%;
    }

    .hero-bar-logo {
      height: 34px;
    }

    .hero-bar-nav {
      display: none;
    }

    .hero-tiles {
      height: 38%;
    }

    .tile-svcs {
      display: none;
    }

    .hero-fb {
      right: 12px;
      top: 40px;
    }
  }

  /* ---- O nas ---- */
  .about-section {
    background: #f8f7f5;
    padding: 5rem 1.5rem;
  }

  .about-container {
    margin: 0 auto;
    max-width: 860px;
  }

  .about-header {
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .about-logo {
    display: block;
    height: 80px;
    margin: 0 auto;
    object-fit: contain;
    width: auto;
  }

  .about-tagline {
    color: #555;
    font-size: 1.05rem;
    font-style: italic;
    line-height: 1.55;
  }

  /* Two-column layout: awards | border | text */
  .about-main {
    align-items: flex-start;
    display: flex;
    flex-direction: row;
    gap: 0;
  }

  .about-awards {
    align-items: center;
    display: flex;
    flex: 0 0 30%;
    flex-direction: column;
    gap: 1.75rem;
    justify-content: center;
    padding-right: 2rem;
  }

  .award-link {
    display: block;
    opacity: 0.85;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .award-link:hover {
    opacity: 1;
    transform: scale(1.05);
  }

  .award-img {
    display: block;
    object-fit: contain;
    width: 100%;
  }

  .award-img--wide {
    height: 64px;
  }

  .about-body {
    border-left: 3px solid #ec7f24;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 1.1rem;
    min-width: 0;
    padding-left: 2rem;
  }

  .about-body p {
    color: #333;
    font-size: 1rem;
    line-height: 1.75;
  }

  .about-body a {
    color: #ec7f24;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 680px) {
    .about-section {
      padding: 3.5rem 1.25rem;
    }

    .about-main {
      flex-direction: column;
      gap: 2.5rem;
    }

    .about-awards {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      padding-right: 0;
      width: 100%;
    }

    .award-img {
      height: 80px;
      width: auto;
    }

    .award-img--wide {
      height: 50px;
    }

    .about-body {
      border-left: none;
      border-top: 3px solid #ec7f24;
      padding-left: 0;
      padding-top: 1.5rem;
      width: 100%;
    }
  }
</style>
