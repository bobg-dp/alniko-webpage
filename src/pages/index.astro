---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ServiceSideNav from "../components/ServiceSideNav.astro";
import { services, serviceMap } from "../config/services";
import siteData from "../config/site-data.json";

const allLocations = siteData.locations;
const home = siteData.homePage;
const about = home.about;
const contact = home.contact;
const gallery = home.gallery;
const lightbox = home.lightbox;
const testimonials = home.testimonials;
const gallerySections = gallery.sections;
const mapLocsJson = JSON.stringify(
  allLocations.map((loc) => ({
    id: loc.id,
    lat: loc.lat,
    lng: loc.lng,
    city: loc.city,
    addr: loc.address,
  })),
);
---

<Layout
  title={home.meta.title}
  description={home.meta.description}
  hideHeader={true}
  hideFooter={true}
>
  <ServiceSideNav linkMode="sections" />
  <main>
    <section class="hero" aria-label={home.hero.ariaLabel}>

      <!-- Slideshow -->
      <div class="slideshow">
        {services.map((service, i) => (
          <div
            class="slide"
            data-slug={service.slug}
            style={`--slide-bg: url('${service.panelBg}'); animation-delay: ${i * 5}s;`}
          >
            <div class="slide-title-wrap">
              <h2 class="slide-title">{service.name}</h2>
            </div>
          </div>
        ))}
      </div>

      <!-- Overlay gradient -->
      <div class="hero-overlay" aria-hidden="true" />

      <!-- Header bar -->
      <SiteNav />

      <!-- Facebook icon (outside bar, right side — visible in hero only) -->
      <a
        href={siteData.meta.facebookUrl}
        class="hero-fb"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={home.hero.facebookAriaLabel}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
        </svg>
      </a>

      <!-- Location tiles (bottom) -->
      <div class="hero-tiles" id="lokalizacje">
        {allLocations.map((loc, i) => (
            <a
              href="#kontakt"
              class="hero-tile"
              style={`--tile-color: ${loc.tileColor}; --tile-bg: url('${loc.tileBg}'); animation-delay: ${0.3 + i * 0.22}s;`}
              data-loc-id={loc.id}
              aria-label={`${loc.city}, ${loc.address}`}
            >
              <span class="tile-city">{loc.city}</span>
              <span class="tile-address">{loc.postcode} {loc.address}</span>
              <div class="tile-svcs">
                {(loc.services as string[]).map(slug => {
                  const svc = serviceMap[slug as keyof typeof serviceMap];
                  return svc ? (
                    <span class="tile-svc-tag" style={`--tag-color: ${svc.color};`}>{svc.shortName}</span>
                  ) : null;
                })}
              </div>
            </a>
        ))}
      </div>

    </section>

    <!-- O nas -->
    <section id="o-nas" class="about-section">
      <div class="about-container">

        <div class="about-header">
          <a href="/">
            <img src="/alniko.webp" alt={about.logoAlt} class="about-logo" />
          </a>
          <h1 class="about-heading" set:html={home.h1} />
        </div>

        <div class="about-main">

          <div class="about-awards">
            {about.awards.map((award) => (
              <a href={award.href} target="_blank" rel="noopener noreferrer" class="award-link" aria-label={award.ariaLabel}>
                <img src={award.imgSrc} alt={award.alt} class="award-img" />
              </a>
            ))}
          </div>

          <div class="about-body">
            <p class="about-tagline" set:html={about.tagline} />
            {about.body.map((paragraph) => <p set:html={paragraph} />)}
          </div>

        </div>

      </div>
    </section>

    <!-- Service sections interleaved with stats & testimonials -->
    {services.map((service, i) => (
      <Fragment key={service.slug}>

        <section
          id={`service-${service.slug}`}
          class="svc-section"
          style={`--svc-color: ${service.color};`}
        >
          <div class:list={["svc-container", i % 2 === 1 && "svc-reverse"]}>

            <div class="svc-text svc-slide svc-slide-left">
              <span class="svc-eyebrow">{service.shortName}</span>
              <h2 class="svc-title">{service.name}</h2>
              <div class="svc-desc" set:html={service.description} />
              {service.highlights && service.highlights.length > 0 && (
                <ul class="svc-highlights">
                  {service.highlights.map((item) => (
                    <li class="svc-highlight">
                      <Icon name={item.icon} class="svc-highlight-icon" aria-hidden="true" />
                      <span>{item.text}</span>
                    </li>
                  ))}
                </ul>
              )}
              <a href={service.path} class="svc-cta">{service.ctaLabel}</a>
            </div>

            <div
              class="svc-gallery svc-slide svc-slide-right"
              data-layout={service.galleryLayout}
            >
              {service.galleryImages.map((img, gi) => {
                const src = typeof img === "string" ? img : img.src;
                const thumb = typeof img === "string" ? img : (img.thumb ?? img.src);
                return (
                <button
                  class="gallery-thumb"
                  data-src={src}
                  data-gallery={service.slug}
                  data-index={gi}
                  aria-label={`${service.name} – ${home.serviceGalleryAriaSuffix} ${gi + 1}`}
                >
                  <img src={thumb} alt={`${service.name} – ${home.serviceGalleryAriaSuffix} ${gi + 1}`} loading="lazy" />
                  <span class="gallery-zoom" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                      <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2"/>
                      <path d="m21 21-4.35-4.35M11 8v6M8 11h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                  </span>
                </button>
                );
              })}
            </div>

          </div>
        </section>

        {/* Stats after first service */}
        {i === 0 && (
          <section class="stats-section">
            <div class="stats-container">
              {home.stats.map((stat, si) => (
                <Fragment>
                  {si > 0 && <div class="stat-divider" aria-hidden="true" />}
                  <div class="stat-item">
                    <span
                      class="stat-num"
                      data-target={stat.value}
                      data-from={stat.from}
                      {...("decimals" in stat && stat.decimals != null ? { "data-decimals": String(stat.decimals) } : {})}
                    >{stat.value}</span>
                    <span class="stat-label">
                      {stat.label}
                      {"stars" in stat && stat.stars && (
                        <span class="stat-stars" aria-label={stat.starsAriaLabel}>{stat.stars}</span>
                      )}
                    </span>
                  </div>
                </Fragment>
              ))}
            </div>
          </section>
        )}

        {/* Testimonials after second service */}
        {i === 1 && (
          <section class="testi-section">
            <div class="testi-container">
              <span class="testi-bigquote" aria-hidden="true">"</span>
              <div class="testi-track">
                {testimonials.map((t, ti) => (
                  <blockquote class:list={["testi-item", ti === 0 && "is-active"]}>
                    <p class="testi-text">{t.text}</p>
                    <footer class="testi-author">— {t.author}</footer>
                  </blockquote>
                ))}
              </div>
              <div class="testi-dots">
                {testimonials.map((_, ti) => (
                  <button
                    class:list={["testi-dot", ti === 0 && "is-active"]}
                    data-index={ti}
                    aria-label={`${home.testimonialsAriaLabel} ${ti + 1}`}
                  />
                ))}
              </div>
            </div>
          </section>
        )}

      </Fragment>
    ))}

    <!-- Kontakt -->
    <section id="kontakt" class="contact-section">
      <div class="contact-container">

        <div class="contact-header">
          <h2 class="contact-title">{contact.title}</h2>
          <p class="contact-intro">
            {contact.introBefore}
            <a href={siteData.meta.facebookUrl} target="_blank" rel="noopener noreferrer">{contact.introLinkLabel}</a>{contact.introAfter}
          </p>
        </div>

          <div class="contact-cards">
            {allLocations.map(loc => (
              <div
                class="contact-card"
                data-lat={loc.lat}
                data-lng={loc.lng}
                data-id={loc.id}
                role="button"
                tabindex="0"
                aria-label={`${loc.city}, ${loc.address}`}
              >
                <div class="contact-card-header">
                  <span class="contact-city">{loc.city}</span>
                  <a
                    href={`tel:${loc.phone.replace(/\s/g, '')}`}
                    class="contact-phone"
                    aria-label={`${contact.callAriaPrefix} ${loc.phone}`}
                    onclick="event.stopPropagation()"
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.06 6.06l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    {loc.phone}
                  </a>
                </div>
                <p class="contact-address">{loc.postcode}&nbsp;{loc.address}</p>
                <div class="contact-tags">
                  {(loc.services as string[]).map(slug => {
                    const svc = serviceMap[slug as keyof typeof serviceMap];
                    return svc ? (
                      <span class="contact-tag" style={`--tag-color: ${svc.color};`}>{svc.shortName}</span>
                    ) : null;
                  })}
                </div>
                <a
                  href={`https://www.google.com/maps/dir/?api=1&destination=${loc.lat},${loc.lng}`}
                  class="contact-navigate"
                  target="_blank"
                  rel="noopener noreferrer"
                  onclick="event.stopPropagation()"
                >
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                    <circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="2"/>
                  </svg>
                  {contact.navigateLabel}
                </a>
              </div>
            ))}
          </div>

        <div class="contact-map-wrap">
          <div id="contact-map"></div>
        </div>

      </div>
    </section>

    <!-- ===== GALLERY ===== -->
    <section id="galeria" class="gallery-section">
      <div class="gallery-container">
        <div class="gallery-header">
          <h2 class="gallery-title">{gallery.title}</h2>
          <p class="gallery-subtitle">{gallery.subtitle}</p>
        </div>
        {gallerySections.map((section) => (
          <div class="gallery-group" id={`galeria-${section.id}`}>
            <h3 class="gallery-group-title">{section.title}</h3>
            <div class="gallery-grid">
              {section.images.map((img, i) => (
                <button
                  class="gallery-thumb"
                  data-gallery={`main-${section.id}`}
                  data-index={i}
                  data-src={img.src}
                  data-caption={img.caption}
                  aria-label={img.caption}
                >
                  <img src={img.src} alt={img.caption} loading="lazy" />
                  <span class="gallery-cap">{img.caption}</span>
                </button>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ===== FOOTER ===== -->
    <SiteFooter />

    <!-- Lightbox -->
    <div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label={lightbox.ariaLabel} hidden>
      <button class="lb-close" id="lb-close" aria-label={lightbox.closeLabel}>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M18 6 6 18M6 6l12 12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
      </button>
      <button class="lb-nav lb-prev" id="lb-prev" aria-label={lightbox.prevLabel}>
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none"><path d="m15 18-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="lb-content">
        <img id="lb-img" src="" alt="" class="lb-img" />
        <p id="lb-caption" class="lb-caption"></p>
      </div>
      <button class="lb-nav lb-next" id="lb-next" aria-label={lightbox.nextLabel}>
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none"><path d="m9 18 6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>

  </main>
</Layout>

<style>
  /* ---- Reset & base ---- */
  * { box-sizing: border-box; margin: 0; padding: 0; }

  /* ---- Hero ---- */
  .hero {
    height: 100vh;
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  /* ---- Slideshow ---- */
  .slideshow {
    height: 100%;
    inset: 0;
    position: absolute;
    width: 100%;
  }

  .slide {
    animation: slide-show 20s infinite;
    animation-fill-mode: backwards;
    display: flex;
    flex-direction: column;
    inset: 0;
    opacity: 0;
    overflow: hidden;
    position: absolute;
    transition: none;
    z-index: 0;
  }

  /* Background lives here so Ken Burns doesn't affect content */
  .slide::before {
    animation: kb-zoom-in 14s ease-in-out infinite alternate;
    background-image: var(--slide-bg);
    background-position: center;
    background-size: cover;
    content: '';
    inset: -4%;
    position: absolute;
    z-index: 0;
  }

  .slide:nth-child(2)::before {
    animation-name: kb-pan-right;
    animation-duration: 18s;
  }

  .slide:nth-child(3)::before {
    animation-name: kb-zoom-out;
    animation-duration: 12s;
  }

  .slide:nth-child(4)::before {
    animation-name: kb-drift-left;
    animation-duration: 16s;
  }

  @keyframes kb-zoom-in {
    from { transform: scale(1); }
    to   { transform: scale(1.06); }
  }

  @keyframes kb-pan-right {
    from { transform: scale(1.04) translateX(-1.5%); }
    to   { transform: scale(1.04) translateX(1.5%); }
  }

  @keyframes kb-zoom-out {
    from { transform: scale(1.06); }
    to   { transform: scale(1); }
  }

  @keyframes kb-drift-left {
    from { transform: scale(1.04) translateX(1.5%); }
    to   { transform: scale(1.04) translateX(-1.5%); }
  }

  @keyframes slide-show {
    0%   { opacity: 0; }
    8%   { opacity: 1; }
    25%  { opacity: 1; }
    33%  { opacity: 0; }
    100% { opacity: 0; }
  }

  /* ---- Slide content ---- */

  .slide-title-wrap {
    align-items: center;
    box-sizing: border-box;
    display: flex;
    flex: 1;
    justify-content: center;
    overflow: hidden;
    padding: 6rem 5vw 20%;
    position: relative;
    width: 100%;
    z-index: 1;
  }

  .slide-title {
    color: #fff;
    font-size: clamp(1.3rem, 7vw, 3.9rem);
    font-weight: 900;
    letter-spacing: 0.06em;
    line-height: 1.1;
    margin: 0;
    text-align: center;
    text-shadow: 0 2px 28px rgba(0, 0, 0, 0.75);
    text-transform: uppercase;
  }

  .slide-locs { display: none; }

  /* ---- Overlay ---- */
  .hero-overlay {
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.35) 0%,
      rgba(0, 0, 0, 0.15) 55%,
      rgba(0, 0, 0, 0.55) 100%
    );
    inset: 0;
    position: absolute;
    z-index: 1;
  }

  /* ---- Header bar (styles live in SiteNav.astro component) ---- */
  /* Ensure bar sits above hero-overlay (z-index:1) regardless of CSS scope */
  :global(.hero-bar) {
    z-index: 50 !important;
  }

  /* Facebook icon — outside bar, right side */
  .hero-fb {
    align-items: center;
    background: #ec7f24;
    color: #fff;
    display: flex;
    height: 80px;
    justify-content: center;
    padding: 0 16px;
    position: absolute;
    right: 0;
    top: 100px;
    transition: background 0.35s ease, color 0.2s ease, transform 0.2s ease;
    z-index: 11;
  }

  .hero-fb:hover {
    background: color-mix(in srgb, #ec7f24 85%, white);
    transform: scale(1.04);
  }

  /* ---- Service tiles ---- */
  .hero-tiles {
    bottom: 0;
    display: flex;
    height: 25%;
    left: 0;
    position: absolute;
    scroll-margin-top: 100px;
    width: 100%;
    z-index: 5;
  }

  @keyframes tile-fadein {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-tile {
    align-items: center;
    animation: tile-fadein 0.65s ease forwards;
    background-image: var(--tile-bg);
    background-position: center;
    background-size: cover;
    clip-path: polygon(16px 0%, 100% 0%, calc(100% - 16px) 100%, 0% 100%);
    color: #fff;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.85rem;
    justify-content: center;
    opacity: 0;
    overflow: hidden;
    padding: 1.5rem 1.5rem;
    position: relative;
    text-decoration: none;
    transition: transform 0.3s ease;
  }

  /* Overlap to close gaps */
  .hero-tile:not(:first-child) {
    margin-left: -16px;
  }

  /* Stacking: each tile on top of the previous */
  .hero-tile:nth-child(1) { z-index: 1; }
  .hero-tile:nth-child(2) { z-index: 2; }
  .hero-tile:nth-child(3) { z-index: 3; }

  /* First tile: straight left edge */
  .hero-tile:first-child {
    clip-path: polygon(0 0%, 100% 0%, calc(100% - 16px) 100%, 0% 100%);
  }

  /* Last tile: straight right edge */
  .hero-tile:last-child {
    clip-path: polygon(16px 0%, 100% 0%, 100% 100%, 0% 100%);
  }

  /* Color overlay */
  .hero-tile::before {
    background: color-mix(in srgb, var(--tile-color), black 30%);
    content: '';
    inset: 0;
    opacity: 0.88;
    position: absolute;
    transition: opacity 0.3s ease;
    z-index: 0;
  }

  /* Top shimmer line */
  .hero-tile::after {
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.22), transparent);
    content: '';
    height: 1px;
    left: 0;
    position: absolute;
    top: 0;
    transform: scaleX(0);
    transition: transform 0.4s ease;
    width: 100%;
    z-index: 1;
  }

  .hero-tile:hover {
    transform: translateY(-6px);
    z-index: 10;
  }

  .hero-tile:hover::before {
    opacity: 0.65;
  }

  .hero-tile:hover::after {
    transform: scaleX(1);
  }

  .hero-tile > * {
    position: relative;
    z-index: 1;
  }

  .tile-city {
    font-family: var(--font-title);
    font-size: clamp(0.81rem, 3.31vw, 1.45rem);
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1.1;
    text-align: center;
    text-shadow: 0 2px 10px rgba(0,0,0,0.65);
    text-transform: uppercase;
  }

  .tile-address {
    font-size: clamp(0.64rem, 2.28vw, 0.91rem);
    font-weight: 500;
    letter-spacing: 0.03em;
    opacity: 0.88;
    text-align: center;
    text-shadow: 0 1px 6px rgba(0,0,0,0.55);
  }

  .tile-svcs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    justify-content: center;
    margin-top: 0.15rem;
  }

  .tile-svc-tag {
    background: color-mix(in srgb, var(--tag-color) 55%, transparent);
    border: 1px solid color-mix(in srgb, var(--tag-color) 75%, white 25%);
    clip-path: polygon(0 0, calc(100% - 6px) 0, 100% 6px, 100% 100%, 6px 100%, 0 calc(100% - 6px));
    font-size: clamp(0.58rem, 0.85vw, 0.72rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.55rem;
    text-align: center;
    text-shadow: 0 1px 4px rgba(0,0,0,0.4);
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* ---- Responsive ---- */
  @media (max-width: 680px) {
    .hero-tiles {
      flex-direction: column;
      height: 34%;
    }

    /* Mobile: flat edges, no slanting, proper spacing */
    .hero-tile {
      clip-path: none !important;
      flex: 1;
      margin-left: 0 !important;
      padding-bottom: 8px;
      padding-top: 8px;
    }

    .hero-tile:not(:last-child) {
      border-bottom: 1px solid black;
    }

    /* Reset z-index stacking for column layout */
    .hero-tile:nth-child(1) { z-index: 1; }
    .hero-tile:nth-child(2) { z-index: 1; }
    .hero-tile:nth-child(3) { z-index: 1; }

    .tile-svcs {
      display: none;
    }

    .hero-fb {
      display: none;
    }

    .slide-title-wrap {
      padding: 4rem 6vw 70%;
    }

    .slide-title {
      font-size: clamp(1.1rem, 8.5vw, 2.2rem);
      width: 100%;
    }

    .slide[data-slug="hoses"] .slide-title {
      font-size: clamp(1.0rem, 8.5vw, calc(2.2rem - 4pt));
    }
  }

  @media (max-width: 390px) {
    .slide-title {
      font-size: clamp(1rem, 9vw, 1.8rem);
      width: 100%;
    }

    .tile-city {
      font-size: clamp(1.0rem, 5.43vw, 1.43rem);
    }

    .tile-address {
      font-size: clamp(0.83rem, 3.72vw, 1.14rem);
    }
  }

  @media (orientation: landscape) and (max-height: 600px) {
    .slide-title {
      font-size: clamp(1rem, 6vw, 1.8rem);
    }
  }

  /* ---- Service sections ---- */
  .svc-section {
    background: color-mix(in srgb, var(--svc-color) 7%, #f9f8f6);
    border-top: 5px solid color-mix(in srgb, var(--svc-color) 75%, black 25%);
    padding: 5rem 2rem;
  }

  .svc-container {
    align-items: center;
    display: grid;
    gap: 3.5rem;
    grid-template-columns: 3fr 2fr;
    margin: 0 auto;
    max-width: 1100px;
  }

  .svc-container.svc-reverse {
    grid-template-columns: 2fr 3fr;
  }

  .svc-container.svc-reverse .svc-text  { order: 2; }
  .svc-container.svc-reverse .svc-gallery { order: 1; }

  .svc-container:has(.svc-gallery[data-layout="hero-mini"]) {
    align-items: start;
  }

  /* Slide-in base */
  .svc-slide {
    opacity: 0;
    transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .svc-slide-left  { transform: translateX(-56px); }
  .svc-slide-right { transform: translateX(56px); }

  .svc-container.svc-reverse .svc-slide-left  { transform: translateX(56px); }
  .svc-container.svc-reverse .svc-slide-right { transform: translateX(-56px); }

  .svc-slide.is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  .svc-gallery.svc-slide { transition-delay: 0.12s; }

  /* Text column */
  .svc-eyebrow {
    color: var(--svc-color);
    display: block;
    font-family: var(--font-title);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    margin-bottom: 0.7rem;
    text-transform: uppercase;
  }

  .svc-title {
    color: #1a1a1a;
    font-family: var(--font-title);
    font-size: clamp(1.3rem, 2.4vw, 2rem);
    font-weight: 900;
    letter-spacing: 0.04em;
    line-height: 1.2;
    margin-bottom: 1.25rem;
    text-transform: uppercase;
  }

  .svc-desc {
    color: #444;
    font-size: 0.97rem;
    line-height: 1.78;
    margin-bottom: 1.75rem;
  }

  .svc-desc :global(p) {
    margin: 0 0 0.9rem;
  }

  .svc-desc :global(p:last-child) {
    margin-bottom: 0;
  }

  .svc-desc :global(ul) {
    margin: 0 0 0.9rem;
    padding-left: 1.15rem;
  }

  .svc-desc :global(li) {
    margin-bottom: 0.3rem;
  }

  .svc-desc :global(strong) {
    color: #1a1a1a;
    font-weight: 700;
  }

  .svc-highlights {
    display: grid;
    gap: 0.42rem 0.78rem;
    grid-template-columns: 1fr 1fr;
    list-style: none;
    margin: 0 0 1.35rem;
    padding: 0;
  }

  .svc-highlight {
    align-items: center;
    color: #333;
    display: flex;
    font-size: 0.77rem;
    font-weight: 600;
    gap: 0.48rem;
    letter-spacing: 0.01em;
    line-height: 1.25;
    min-width: 0;
  }

  .svc-highlight-icon {
    color: var(--color-accent);
    flex-shrink: 0;
    height: 1.14rem;
    width: 1.14rem;
  }

  @media (max-width: 520px) {
    .svc-highlights {
      grid-template-columns: 1fr;
    }
  }

  .svc-cta {
    background: var(--svc-color);
    clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 10px 100%, 0 calc(100% - 10px));
    color: #fff;
    display: inline-block;
    font-family: var(--font-title);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    padding: 0.75rem 1.6rem;
    text-decoration: none;
    text-transform: uppercase;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .svc-cta:hover {
    opacity: 0.85;
    transform: translateY(-2px);
  }

  /* Gallery */
  .svc-gallery {
    display: grid;
    gap: 0.65rem;
    grid-template-rows: 1fr 1fr;
  }

  .gallery-thumb {
    border: none;
    cursor: zoom-in;
    overflow: hidden;
    padding: 0;
    position: relative;
  }

  .gallery-thumb img {
    display: block;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
    width: 100%;
  }

  .svc-gallery .gallery-thumb {
    aspect-ratio: 16 / 10;
    background: #ddd;
    width: 100%;
  }

  .svc-gallery .gallery-thumb::before {
    background: color-mix(in srgb, var(--svc-color) 55%, black 25%);
    content: '';
    inset: 0;
    opacity: 0;
    position: absolute;
    transition: opacity 0.3s ease;
    z-index: 1;
  }

  .gallery-zoom {
    align-items: center;
    color: #fff;
    display: flex;
    inset: 0;
    justify-content: center;
    opacity: 0;
    position: absolute;
    transition: opacity 0.3s ease;
    z-index: 2;
  }

  .gallery-thumb:hover img             { transform: scale(1.06); }
  .svc-gallery .gallery-thumb:hover::before { opacity: 1; }
  .gallery-thumb:hover .gallery-zoom   { opacity: 1; }

  /* Lightbox */
  .lightbox {
    align-items: center;
    background: rgba(0, 0, 0, 0.92);
    display: flex;
    inset: 0;
    justify-content: center;
    opacity: 0;
    position: fixed;
    transition: opacity 0.38s ease;
    z-index: 9999;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox.is-open {
    opacity: 1;
  }

  .lightbox.is-closing {
    opacity: 0;
  }

  .lb-close {
    background: none;
    border: none;
    color: #fff;
    cursor: pointer;
    opacity: 0;
    padding: 0.5rem;
    position: absolute;
    right: 1.5rem;
    top: 1.5rem;
    transition: opacity 0.3s ease 0.12s;
  }

  .lightbox.is-open .lb-close {
    opacity: 1;
  }

  .lb-nav {
    background: rgba(255, 255, 255, 0.12);
    border: none;
    color: #fff;
    cursor: pointer;
    opacity: 0;
    padding: 0.75rem;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    transition: background 0.2s ease, opacity 0.3s ease 0.12s;
  }

  .lightbox.is-open .lb-nav {
    opacity: 1;
  }

  .lb-nav:hover { background: rgba(255, 255, 255, 0.26); }
  .lb-prev { left: 1.5rem; }
  .lb-next { right: 1.5rem; }

  .lb-content {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-height: 90vh;
    max-width: 88vw;
  }

  .lb-img {
    max-height: 80vh;
    max-width: 88vw;
    object-fit: contain;
    transform-origin: center center;
    transition: opacity 0.28s ease;
    user-select: none;
    will-change: transform;
  }

  .lb-img.is-fading {
    opacity: 0;
  }

  .lb-caption {
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    margin: 0;
    opacity: 0;
    text-align: center;
    text-shadow: 0 1px 4px rgba(0,0,0,0.6);
    text-transform: uppercase;
    transition: opacity 0.35s ease 0.15s;
  }

  .lightbox.is-open .lb-caption {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox,
    .lb-close,
    .lb-nav,
    .lb-img,
    .lb-caption {
      transition: none;
    }
  }

  /* ===== GALLERY SECTION ===== */
  .gallery-section {
    background: #0f0f0f;
    padding: 5rem 0 4rem;
  }

  .gallery-container {
    margin: 0 auto;
    max-width: 1280px;
    padding: 0 2rem;
  }

  .gallery-header {
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .gallery-title {
    color: #fff;
    font-family: var(--font-title);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 900;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
  }

  .gallery-subtitle {
    color: rgba(255,255,255,0.5);
    font-size: 0.95rem;
    letter-spacing: 0.03em;
    text-align: center;
  }

  .gallery-group {
    margin-top: 2.75rem;
  }

  .gallery-group:first-of-type {
    margin-top: 0;
  }

  .gallery-group-title {
    color: rgba(255, 255, 255, 0.92);
    font-family: var(--font-title);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    font-weight: 700;
    letter-spacing: 0.1em;
    margin-bottom: 1.1rem;
    text-transform: uppercase;
  }

  .gallery-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  }

  .gallery-thumb {
    aspect-ratio: 4/3;
    background: #1a1a1a;
    border: none;
    cursor: zoom-in;
    overflow: hidden;
    padding: 0;
    position: relative;
  }

  .gallery-thumb img {
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s ease;
    width: 100%;
  }

  .gallery-thumb::after {
    background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, transparent 55%);
    content: '';
    inset: 0;
    opacity: 0;
    position: absolute;
    transition: opacity 0.3s ease;
    z-index: 1;
  }

  .gallery-cap {
    bottom: 0.6rem;
    color: #fff;
    font-size: 0.78rem;
    font-weight: 600;
    left: 0;
    letter-spacing: 0.06em;
    opacity: 0;
    padding: 0 0.75rem;
    position: absolute;
    text-align: center;
    text-shadow: 0 1px 6px rgba(0,0,0,0.8);
    text-transform: uppercase;
    transition: opacity 0.3s ease;
    width: 100%;
    z-index: 2;
  }

  .gallery-thumb:hover img    { transform: scale(1.07); }
  .gallery-thumb:hover::after { opacity: 1; }
  .gallery-thumb:hover .gallery-cap { opacity: 1; }

  @media (max-width: 680px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.5rem;
    }
    .gallery-section { padding: 3rem 0 2.5rem; }
    .gallery-container { padding: 0 1rem; }
  }

  /* ===== SITE FOOTER — styles live in SiteFooter.astro ===== */

  @media (max-width: 820px) {
    main {
      padding-bottom: 4.5rem;
    }
  }

  /* Responsive */
  @media (max-width: 820px) {
    .svc-container,
    .svc-container.svc-reverse {
      grid-template-columns: 1fr;
    }

    .svc-container.svc-reverse .svc-text,
    .svc-container.svc-reverse .svc-gallery {
      order: unset;
    }

    .svc-gallery {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto;
    }

    /* Single-image gallery: full width on mobile, cropped to landscape */
    .svc-gallery[data-layout="single"] {
      grid-template-columns: 1fr;
    }

    .svc-gallery[data-layout="single"] .gallery-thumb:first-child {
      aspect-ratio: 16 / 9;
    }

    .svc-gallery[data-layout="hero-mini"] {
      grid-template-columns: repeat(4, 1fr);
    }

    .svc-gallery[data-layout="hero-mini"] .gallery-thumb:nth-child(-n + 3) {
      aspect-ratio: 16 / 10;
      grid-column: 1 / -1;
    }

    .svc-gallery[data-layout="hero-mini"] .gallery-thumb:nth-child(n + 4) {
      aspect-ratio: 3 / 4;
      grid-column: span 1;
    }

    .svc-slide-left,
    .svc-container.svc-reverse .svc-slide-left  { transform: translateX(0) translateY(32px); }
    .svc-slide-right,
    .svc-container.svc-reverse .svc-slide-right { transform: translateX(0) translateY(32px); }
  }

  /* ---- Kontakt ---- */
  .contact-section {
    background: #1e1c1a;
    padding: 5rem 2rem;
  }

  .contact-container {
    display: grid;
    gap: 0 2.5rem;
    grid-template-areas:
      "header ."
      "cards  map";
    grid-template-columns: 2fr 3fr;
    grid-template-rows: auto 1fr;
    margin: 0 auto;
    max-width: 1100px;
  }

  .contact-header   { grid-area: header; padding-bottom: 1.75rem; }
  .contact-cards    { grid-area: cards; }
  .contact-map-wrap { align-self: stretch; grid-area: map; }

  .contact-title {
    color: #fff;
    font-family: var(--font-title);
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: 900;
    letter-spacing: 0.06em;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  .contact-intro {
    color: rgba(255,255,255,0.65);
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .contact-intro a {
    color: #ec7f24;
  }

  .contact-cards {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .contact-card {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    cursor: pointer;
    padding: 1.1rem 1.25rem;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .contact-card:hover {
    background: rgba(255,255,255,0.09);
    border-color: rgba(255,255,255,0.22);
  }

  .contact-card.is-active {
    background: rgba(236, 127, 36, 0.12);
    border-color: #ec7f24;
  }

  .contact-card-header {
    align-items: center;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    margin-bottom: 0.35rem;
  }

  .contact-city {
    color: #fff;
    font-family: var(--font-title);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact-phone {
    align-items: center;
    color: #ec7f24;
    display: inline-flex;
    font-size: 0.85rem;
    font-weight: 600;
    gap: 0.35rem;
    text-decoration: none;
  }

  .contact-phone:hover { text-decoration: underline; }

  .contact-address {
    color: rgba(255,255,255,0.55);
    font-size: 0.85rem;
    margin-bottom: 0.65rem;
  }

  .contact-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
  }

  .contact-tag {
    background: color-mix(in srgb, var(--tag-color) 30%, transparent);
    border: 1px solid color-mix(in srgb, var(--tag-color) 60%, transparent);
    clip-path: polygon(0 0, calc(100% - 6px) 0, 100% 6px, 100% 100%, 6px 100%, 0 calc(100% - 6px));
    color: #fff;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.55rem;
    text-transform: uppercase;
  }

  .contact-navigate {
    align-items: center;
    color: rgba(255,255,255,0.45);
    display: inline-flex;
    font-size: 0.78rem;
    gap: 0.3rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .contact-navigate:hover { color: #ec7f24; }

  .contact-map-wrap {
    position: relative;
  }

  #contact-map {
    border: 2px solid #ec7f24;
    height: 100%;
    min-height: 280px;
    width: 100%;
  }

  @media (max-width: 820px) {
    .contact-container {
      grid-template-areas:
        "header"
        "cards"
        "map";
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto;
    }

    #contact-map {
      height: 320px;
      min-height: unset;
    }
  }

  /* ---- Gallery layout variants ---- */
  /* default = stack (grid-template-rows: 1fr 1fr) — already set */

  .svc-gallery[data-layout="side"] {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto;
  }

  .svc-gallery[data-layout="side"] .gallery-thumb {
    aspect-ratio: 3 / 4;
  }

  .svc-gallery[data-layout="side"] .gallery-thumb:nth-child(3) {
    aspect-ratio: 16 / 10;
    grid-column: 1 / -1;
  }

  .svc-gallery[data-layout="featured"] {
    grid-template-rows: auto auto;
  }

  .svc-gallery[data-layout="featured"] .gallery-thumb:first-child {
    aspect-ratio: 4 / 3;
  }

  .svc-gallery[data-layout="featured"] .gallery-thumb:last-child {
    aspect-ratio: 21 / 9;
  }

  .svc-gallery[data-layout="single"] {
    grid-template-rows: 1fr;
  }

  .svc-gallery[data-layout="single"] .gallery-thumb:first-child {
    aspect-ratio: 3 / 4;
  }

  .svc-gallery[data-layout="single"] .gallery-thumb:last-child {
    display: none;
  }

  /* 3 large stacked (beside text) + mini row below */
  .svc-gallery[data-layout="hero-mini"] {
    display: grid;
    gap: 0.65rem;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: auto;
  }

  .svc-gallery[data-layout="hero-mini"] .gallery-thumb:nth-child(-n + 3) {
    aspect-ratio: 16 / 10;
    grid-column: 1 / -1;
  }

  .svc-gallery[data-layout="hero-mini"] .gallery-thumb:nth-child(n + 4) {
    aspect-ratio: 3 / 4;
    grid-column: span 1;
    margin-top: 0.25rem;
  }

  /* ---- Stats section ---- */
  .stats-section {
    background: #1a1918;
    padding: 4rem 2rem;
  }

  .stats-container {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    justify-content: center;
    margin: 0 auto;
    max-width: 860px;
  }

  .stat-item {
    align-items: center;
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 180px;
    padding: 1rem 2rem;
    text-align: center;
  }

  .stat-num {
    color: #ec7f24;
    display: block;
    font-family: var(--font-title);
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 900;
    letter-spacing: 0.04em;
    line-height: 1;
    transition: opacity 0.3s ease;
  }

  .stat-suffix {
    color: rgba(255,255,255,0.5);
    display: block;
    font-size: 1.1rem;
    margin-top: -0.2rem;
  }

  .stat-label {
    color: rgba(255,255,255,0.65);
    display: flex;
    flex-direction: column;
    font-size: 0.8rem;
    gap: 0.3rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .stat-stars {
    color: #ec7f24;
    display: block;
    font-size: 0.9rem;
    letter-spacing: 0.1em;
  }

  .stat-divider {
    background: rgba(255,255,255,0.12);
    height: 60px;
    width: 1px;
  }

  @media (max-width: 600px) {
    .stat-divider { display: none; }
    .stats-container { gap: 1rem; }
  }

  /* ---- Testimonials section ---- */
  .testi-section {
    background: #1a1918;
    padding: 2.5rem 2rem;
  }

  .testi-container {
    margin: 0 auto;
    max-width: 720px;
    position: relative;
    text-align: center;
  }

  .testi-bigquote {
    color: #ec7f24;
    display: block;
    font-family: Georgia, serif;
    font-size: 5rem;
    line-height: 0.5;
    margin-bottom: 0.75rem;
    opacity: 0.35;
    user-select: none;
  }

  .testi-track {
    min-height: 170px;
    position: relative;
  }

  .testi-item {
    inset: 0;
    margin: 0;
    opacity: 0;
    padding: 0;
    pointer-events: none;
    position: absolute;
    transition: opacity 1.4s ease;
  }

  .testi-item.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .testi-text {
    color: rgba(255, 255, 255, 0.85);
    font-size: clamp(0.95rem, 1.8vw, 1.1rem);
    font-style: italic;
    line-height: 1.65;
    margin-bottom: 0.75rem;
  }

  .testi-author {
    color: #ec7f24;
    font-family: 'Dancing Script', cursive;
    font-size: 1.4rem;
    font-weight: 700;
  }

  .testi-dots {
    display: flex;
    gap: 0.6rem;
    justify-content: center;
    margin-top: 1rem;
  }

  .testi-dot {
    background: rgba(255,255,255,0.2);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    height: 9px;
    padding: 0;
    transition: background 0.25s ease, transform 0.25s ease;
    width: 9px;
  }

  .testi-dot.is-active {
    background: #ec7f24;
    transform: scale(1.3);
  }

  /* ---- O nas ---- */
  .about-section {
    background: #f8f7f5;
    padding: 5rem 1.5rem;
  }

  .about-container {
    margin: 0 auto;
    max-width: 860px;
  }

  .about-header {
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .about-logo {
    display: block;
    height: 80px;
    margin: 0 auto;
    object-fit: contain;
    width: auto;
  }

  .about-heading {
    color: #1a1a1a;
    font-family: var(--font-title);
    font-size: clamp(1.05rem, 2.2vw, 1.45rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.35;
    margin: 1.25rem auto 0;
    max-width: 36ch;
    text-align: center;
    text-transform: uppercase;
  }

  .about-tagline {
    color: #555;
    font-size: 1.05rem;
    font-style: italic;
    line-height: 1.55;
  }

  /* Two-column layout: awards | border | text */
  .about-main {
    align-items: flex-start;
    display: flex;
    flex-direction: row;
    gap: 0;
  }

  .about-awards {
    align-items: center;
    display: flex;
    flex: 0 0 30%;
    flex-direction: column;
    gap: 1.75rem;
    justify-content: center;
    padding-right: 2rem;
  }

  .award-link {
    display: block;
    opacity: 0.85;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .award-link:hover {
    opacity: 1;
    transform: scale(1.05);
  }

  .award-img {
    display: block;
    object-fit: contain;
    width: 100%;
  }

  .award-img--wide {
    height: 64px;
  }

  .about-body {
    border-left: 3px solid #ec7f24;
    display: flex;
    flex-direction: column;
