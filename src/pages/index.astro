---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../config/site";
import { services } from "../config/services";
import { Icon } from "astro-icon/components";
import siteData from "../config/site-data.json";

const content = siteData.homePage;
const locations = siteData.locations;

const serviceColorMap: Record<string, string> = Object.fromEntries(
  siteData.services.map(s => [s.slug, s.color])
);
const serviceNameMap: Record<string, string> = Object.fromEntries(
  siteData.services.map(s => [s.slug, s.shortName])
);
---

<Layout
  title="ALNIKO - skład opału, skup złomu, zakuwanie węży hydraulicznych, skup katalizatorów"
  description="ALNIKO działa w Jeleniej Górze i Ząbkowicach Śląskich: skup złomu, skład opału, zakuwanie węży hydraulicznych i skup katalizatorów."
  hideHeader={true}
  hideFooter={true}
>
  <main>
    <section class="hero-accordion" aria-label="ALNIKO — działalności firmy">
      <img class="accordion-logo" src="/alniko.webp" alt="ALNIKO" width="200" height="65" />

      <div class="accordion-panel panel-intro is-active" data-panel="intro">
        <div class="panel-inner">
          <div class="panel-content">
            <img class="intro-logo" src="/alniko.webp" alt="ALNIKO" width="280" height="90" />
            <p class="panel-tagline" set:html={content.intro.tagline} />
            <h1 class="panel-heading">{content.intro.heading}</h1>
            <div class="panel-body">
              {content.intro.body.map(p => <p set:html={p} />)}
            </div>
            <p class="intro-features-heading" set:html={content.intro.featuresHeading} />
            <ul class="intro-features">
              {content.intro.features.map(f => (
                <li>
                  <Icon name={f.icon} class="feature-icon" aria-hidden="true" />
                  <span set:html={f.text} />
                </li>
              ))}
            </ul>
          </div>
          <a class="panel-contact-link intro-cta" href={content.intro.ctaHref}>
            <span set:html={content.intro.ctaLabel} />
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <span class="panel-label panel-label-intro">
            O Nas
          </span>
        </div>
      </div>

      {services.map((service) => (
        <div
          class="accordion-panel panel-service"
          data-panel={service.slug}
          style={`--panel-color: ${service.color};`}
        >
          <img class="panel-bg" src={service.panelBg} alt="" />
          <div class="panel-overlay" />
          <div class="panel-inner">
            <div class="panel-content">
              <h2 class="panel-title">{service.name}</h2>
              <p class="panel-text" set:html={service.description} />
              <a class="panel-link" href={`#service-${service.slug}`}>
                <span>Dowiedz się więcej</span>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
            <span class="panel-label" set:html={service.shortName.split(' ').join('<br>')} />
          </div>
        </div>
      ))}
    </section>

    <!-- Locations section -->
    <section id="lokalizacje" class="locations-section">
      <div class="loc-header">
        <h2 class="loc-title">Nasze lokalizacje</h2>
        <p class="loc-subtitle">Obsługujemy klientów w Jeleniej Górze i Ząbkowicach Śląskich</p>
      </div>
      <div class="loc-container">
        <div class="loc-cards">
          {locations.map((loc, i) => (
            <button
              class="loc-card"
              data-loc-id={loc.id}
              data-lat={loc.lat}
              data-lng={loc.lng}
              type="button"
            >
              <div class="loc-card-marker">{i + 1}</div>
              <div class="loc-card-body">
                <div class="loc-card-city">{loc.city}</div>
                <div class="loc-card-address">{loc.address}, {loc.postcode}</div>
                <div class="loc-card-tags">
                  {loc.services.map(slug => (
                    <span
                      class="loc-tag"
                      style={`--tag-color: ${serviceColorMap[slug]}`}
                    >{serviceNameMap[slug]}</span>
                  ))}
                </div>
                <div class="loc-card-actions">
                  <a class="loc-phone" href={`tel:${loc.phone.replace(/\s/g, '')}`} onclick="event.stopPropagation()">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.62 3.47 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6 6l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    {loc.phone}
                  </a>
                  <a
                    class="loc-navigate"
                    href={`https://www.google.com/maps/dir/?api=1&destination=${loc.lat},${loc.lng}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    onclick="event.stopPropagation()"
                    aria-label={`Nawiguj do ${loc.address}`}
                  >
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M12 2L4.5 20.29l.71.71L12 18l6.79 3 .71-.71z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    Nawiguj
                  </a>
                </div>
              </div>
            </button>
          ))}
        </div>
        <div class="loc-map-wrap">
          <div id="locations-map"></div>
        </div>
      </div>
    </section>

    <!-- Service detail sections -->
    {services.map((service, i) => (
      <section
        id={`service-${service.slug}`}
        class={`service-section${i % 2 === 1 ? ' svc-reverse' : ''}${i == 1 ? ' svc-mirror' : ''}`}
        style={`--svc-color: ${service.color}; --svc-bg: url('${service.sectionImage}');`}
      >
        <div class="svc-text">
          <span class="svc-badge">{service.shortName}</span>
          <h2 class="svc-heading">{service.name}</h2>
          <div class="svc-body" set:html={service.description} />
          <a class="svc-cta" href={service.path}>
            <span>{service.ctaLabel}</span>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </section>
    ))}
  </main>

  <!-- Locations CTA tab (bottom center) -->
  <button class="loc-tab" id="loc-tab" aria-label="Nasze lokalizacje">
    <Icon name="lucide:map-pin" class="loc-tab-icon" aria-hidden="true" />
    <span>Nasze&nbsp;lokalizacje</span>
  </button>

  <!-- Leaflet map (self-contained, no integrity hashes) -->
  <script is:inline>
    (function () {
      var css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
      document.head.appendChild(css);

      var js = document.createElement('script');
      js.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
      js.onload = function () {
        var mapEl = document.getElementById('locations-map');
        if (!mapEl) return;

        var L = window.L;
        var locs = [
          { id: 'jg-powstancow',       lat: 50.9154, lng: 15.7225, label: 'Jelenia Góra<br>ul. Powstańców Śląskich 41' },
          { id: 'jg-wroclawska',        lat: 50.8978, lng: 15.7472, label: 'Jelenia Góra<br>ul. Wrocławska 35' },
          { id: 'zabkowice-wroclawska', lat: 50.5903, lng: 16.8134, label: 'Ząbkowice Śląskie<br>ul. Wrocławska 27' },
        ];

        var map = L.map('locations-map', { scrollWheelZoom: false });

        L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
          subdomains: 'abcd',
          maxZoom: 19,
        }).addTo(map);

        function makeIcon(num, active) {
          var c = active ? '#c96b1a' : '#ec7f24';
          return L.divIcon({
            className: '',
            html: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 44" width="32" height="44">'
              + '<path d="M16 0C7.163 0 0 7.163 0 16c0 11 16 28 16 28S32 27 32 16C32 7.163 24.837 0 16 0z" fill="' + c + '"/>'
              + '<text x="16" y="21" text-anchor="middle" dominant-baseline="middle" fill="white" font-size="14" font-weight="bold" font-family="Arial">' + num + '</text>'
              + '</svg>',
            iconSize: [32, 44],
            iconAnchor: [16, 44],
            popupAnchor: [0, -46],
          });
        }

        var markers = {};
        var jgBounds = L.latLngBounds([]);

        locs.forEach(function (loc, i) {
          var m = L.marker([loc.lat, loc.lng], { icon: makeIcon(i + 1, false) })
            .addTo(map)
            .bindPopup('<b>' + loc.label + '</b>');
          markers[loc.id] = { m: m, i: i };
          // Only include Jelenia Góra in initial bounds
          if (loc.id !== 'zabkowice-wroclawska') {
            jgBounds.extend([loc.lat, loc.lng]);
          }
        });

        map.fitBounds(jgBounds, { padding: [60, 60] });

        document.querySelectorAll('.loc-card').forEach(function (card) {
          card.addEventListener('click', function () {
            var id = card.dataset.locId;
            var lat = parseFloat(card.dataset.lat);
            var lng = parseFloat(card.dataset.lng);

            document.querySelectorAll('.loc-card').forEach(function (c) { c.classList.remove('is-active'); });
            card.classList.add('is-active');

            locs.forEach(function (loc, i) {
              markers[loc.id].m.setIcon(makeIcon(i + 1, loc.id === id));
            });
            map.flyTo([lat, lng], 15, { duration: 1.2 });
            markers[id].m.openPopup();
          });
        });
      };
      document.head.appendChild(js);
    })();
  </script>

  <!-- Mobile promotions FAB + overlay -->
  <button class="promo-fab" id="promo-fab" aria-label="Aktualne promocje">
    <Icon name="lucide:tag" class="promo-fab-icon" aria-hidden="true" />
    <span class="promo-fab-label">Aktualne Promocje</span>
  </button>

  <div class="promo-overlay" id="promo-overlay" aria-modal="true" role="dialog" aria-label="Aktualne promocje">
    <button class="promo-close" id="promo-close" aria-label="Zamknij">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
        <path d="M4 4l14 14M18 4L4 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
      </svg>
    </button>
    <div class="promo-overlay-inner">
      <h2 class="promo-overlay-heading" set:html={content.intro.featuresHeading} />
      <ul class="promo-overlay-list">
        {content.intro.features.map(f => (
          <li>
            <Icon name={f.icon} class="promo-overlay-icon" aria-hidden="true" />
            <span set:html={f.text} />
          </li>
        ))}
      </ul>
    </div>
  </div>
</Layout>

<script>
  const panels = document.querySelectorAll<HTMLDivElement>('.accordion-panel');

  const accordion = document.querySelector<HTMLElement>('.hero-accordion');

  function updateAccordionState() {
    const activePanel = document.querySelector<HTMLElement>('.accordion-panel.is-active');
    if (accordion && activePanel) {
      accordion.dataset.active = activePanel.dataset.panel ?? '';
    }
  }

  panels.forEach(panel => {
    panel.addEventListener('click', () => {
      if (panel.classList.contains('is-active')) return;
      panels.forEach(p => p.classList.remove('is-active'));
      panel.classList.add('is-active');
      updateAccordionState();
    });
  });

  updateAccordionState();

  // --- Service section slide-in ---
  const svcObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          (entry.target as HTMLElement).classList.add('is-visible');
          svcObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12 }
  );
  document.querySelectorAll('.svc-text').forEach(el => svcObserver.observe(el));

  // --- Locations tab ---
  const locTab = document.getElementById('loc-tab');
  const lokalizacjeSection = document.getElementById('lokalizacje');

  locTab?.addEventListener('click', () => {
    lokalizacjeSection?.scrollIntoView({ behavior: 'smooth' });
  });

  if (lokalizacjeSection && locTab) {
    const obs = new IntersectionObserver(
      ([entry]) => {
        locTab.classList.toggle('is-hidden', entry.isIntersecting);
      },
      { threshold: 0.15 }
    );
    obs.observe(lokalizacjeSection);
  }

  // --- Promo FAB / overlay ---
  const promoFab = document.getElementById('promo-fab');
  const promoOverlay = document.getElementById('promo-overlay');
  const promoClose = document.getElementById('promo-close');

  function openPromo() {
    promoOverlay?.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }

  function closePromo() {
    promoOverlay?.classList.remove('is-open');
    document.body.style.overflow = '';
  }

  promoFab?.addEventListener('click', openPromo);
  promoClose?.addEventListener('click', closePromo);

  promoOverlay?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closePromo();
  });
</script>

<style>
  .hero-accordion {
    display: flex;
    height: 100vh;
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  .accordion-panel {
    cursor: pointer;
    flex: 1;
    overflow: hidden;
    position: relative;
    transition: flex 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .accordion-panel.is-active {
    flex: 3;
  }

  .panel-intro.is-active {
    flex: 3;
  }

  .accordion-panel::before {
    content: '';
    inset: 0;
    position: absolute;
    z-index: 2;
    background: linear-gradient(to right,
      transparent 0%,
      transparent calc(100% - 3px),
      rgba(255, 255, 255, 0.08) calc(100% - 2px),
      transparent 100%
    );
    pointer-events: none;
  }

  /* Skew edges via clip-path */
  .accordion-panel:not(:first-child) {
    margin-left: -60px;
    clip-path: polygon(60px 0, 100% 0, 100% 100%, 0 100%);
  }

  .accordion-panel:not(:last-child) {
    clip-path: polygon(0 0, 100% 0, calc(100% - 60px) 100%, 0 100%);
  }

  .accordion-panel:not(:first-child):not(:last-child) {
    clip-path: polygon(60px 0, 100% 0, calc(100% - 60px) 100%, 0 100%);
  }

  /* --- Intro Panel --- */

  .panel-intro {
    --panel-color: #ffffff;
    background: #ffffff;
    padding-left: 50px;
  }

  .panel-intro .panel-inner {
    justify-content: space-between;
    padding: 2rem 1.5rem 2rem;
  }

  .panel-intro .panel-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin: auto 0;
    max-width: none;
    opacity: 0;
    padding: 0;
    pointer-events: none;
    transform: translateY(12px);
    transition: opacity 0.12s ease 0s, transform 0.12s ease 0s;
  }

  .panel-intro.is-active .panel-content {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
    transition: opacity 0.4s ease 0.35s, transform 0.4s ease 0.35s;
  }

  .intro-logo {
    display: block;
    height: auto;
    margin: 0 auto;
    max-width: 340px;
    width: 100%;
  }

  .intro-cta {
    flex-shrink: 0;
    opacity: 0;
    pointer-events: none;
    transform: translateY(10px);
    transition: opacity 0.12s ease 0s, transform 0.12s ease 0s;
  }

  .panel-intro.is-active .intro-cta {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
    transition: opacity 0.4s ease 0.45s, transform 0.4s ease 0.45s;
  }

  .intro-features-heading {
    color: var(--color-accent);
    filter: drop-shadow(0 1px 4px rgba(236, 127, 36, 0.45));
    font-family: var(--font-title);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    margin: 0.75rem 0 0.5rem;
    max-width: none;
    text-transform: uppercase;
  }

  .intro-features {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: left;
  }

  .intro-features li {
    align-items: flex-start;
    color: #444;
    display: flex;
    font-size: 0.82rem;
    gap: 0.75rem;
    line-height: 1.5;
  }

  .feature-icon {
    color: var(--color-accent);
    flex-shrink: 0;
    height: 28px;
    margin-top: 0.05rem;
    width: 28px;
  }

  .intro-features strong {
    color: var(--color-accent);
  }

  .accordion-logo {
    height: auto;
    left: 1.5rem;
    max-width: 180px;
    opacity: 1;
    pointer-events: none;
    position: absolute;
    top: 1.5rem;
    transform: translateY(0);
    transition: opacity 0.5s ease, transform 0.5s ease;
    width: 100%;
    z-index: 10;
  }

  .hero-accordion[data-active="intro"] .accordion-logo {
    opacity: 0;
    pointer-events: none;
    transform: translateY(-8px);
  }


  .panel-tagline {
    color: var(--color-accent);
    font-family: var(--font-title);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.5;
    margin: 0;
    max-width: none;
    text-transform: uppercase;
  }

  .panel-heading {
    color: var(--color-bg-dark);
    font-size: 1.1rem;
    margin: 0;
  }

  .panel-body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .panel-body p {
    color: #333;
    font-size: 0.85rem;
    line-height: 1.6;
    margin: 0;
    max-width: 460px;
  }

  .panel-body a {
    color: var(--color-accent);
    font-weight: 700;
    text-decoration: none;
  }

  .panel-body strong {
    color: var(--color-bg-dark);
  }

  .panel-contact-link {
    align-items: center;
    background: var(--color-bg-dark);
    color: var(--color-white);
    display: inline-flex;
    flex-shrink: 0;
    font-size: 0.85rem;
    font-weight: 600;
    gap: 0.5rem;
    margin-top: 0.5rem;
    padding: 0.6rem 1.2rem;
    text-decoration: none;
    transform: skewX(-4deg);
    transition: filter 0.2s ease, transform 0.2s ease;
  }

  .panel-contact-link:hover {
    filter: brightness(1.4);
    transform: skewX(-4deg) scale(1.05);
  }

  /* --- Service Panels --- */

  .panel-service {
    background: var(--panel-color);
  }

  .panel-bg {
    height: 100%;
    inset: 0;
    object-fit: cover;
    object-position: center;
    position: absolute;
    width: 100%;
    z-index: 0;
  }

  .panel-overlay {
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--panel-color), transparent 40%) 0%,
      color-mix(in srgb, var(--panel-color), black 30%) 100%
    );
    inset: 0;
    position: absolute;
    z-index: 1;
    transition: opacity 0.6s ease;
  }

  .accordion-panel.is-active .panel-overlay {
    opacity: 0.7;
  }

  .panel-service:not(.is-active) .panel-overlay {
    opacity: 0.85;
  }

  /* --- Panel Inner (shared) --- */

  .panel-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    justify-content: flex-end;
    padding: 2rem 1.5rem;
    position: relative;
    z-index: 3;
  }

  .panel-label {
    color: var(--color-white);
    font-family: var(--font-title);
    font-size: 0.8rem;
    font-weight: 700;
    left: 50%;
    letter-spacing: 0.06em;
    line-height: 1.6;
    opacity: 1;
    padding: 0 0.5rem;
    position: absolute;
    text-align: center;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
    text-transform: uppercase;
    top: 50%;
    transform: translate(-50%, -50%);
    transition: opacity 0.4s ease 0.35s;
    width: 100%;
  }

  .accordion-panel.is-active .panel-label {
    opacity: 0;
    transition: opacity 0.12s ease 0s;
  }

  /* --- Panel Content (expanded state) --- */

  .accordion-panel .panel-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 500px;
    opacity: 0;
    padding: 0 1rem;
    pointer-events: none;
    transform: translateY(12px);
    transition: opacity 0.12s ease 0s, transform 0.12s ease 0s;
  }

  .accordion-panel.is-active .panel-content {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
    transition: opacity 0.4s ease 0.35s, transform 0.4s ease 0.35s;
  }

  .panel-intro .panel-label {
    color: var(--color-bg-dark);
  }

  .panel-title {
    color: var(--color-white);
    font-size: 1.6rem;
    margin: 0;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
  }

  .panel-text {
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  .panel-link {
    align-items: center;
    background: var(--panel-color);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--color-white);
    display: inline-flex;
    font-size: 0.85rem;
    font-weight: 600;
    gap: 0.5rem;
    margin-top: 0.5rem;
    padding: 0.6rem 1.2rem;
    text-decoration: none;
    transform: skewX(-4deg);
    transition: filter 0.2s ease, transform 0.2s ease;
  }

  .panel-link:hover {
    filter: brightness(1.3);
    transform: skewX(-4deg) scale(1.05);
  }

  /* --- Responsive --- */

