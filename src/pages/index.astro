---
import Layout from "../layouts/Layout.astro";
import { services, serviceMap } from "../config/services";
import siteData from "../config/site-data.json";

const allLocations = siteData.locations;

function locsForService(slug: string) {
  return allLocations.filter(loc => (loc.services as string[]).includes(slug));
}

const serviceGallery: Record<string, string[]> = {
  scrap:     ["/panel-scrap.png",     "/fuchs.png"],
  fuel:      ["/panel-fuel.png",      "/fuel-bg.png"],
  hoses:     ["/panel-hoses.png",     "/hoses-bg.png"],
  catalysts: ["/panel-catalysts.png", "/catalysts-bg.png"],
};

const locationStyles: Record<string, { bg: string; color: string }> = {
  "jg-powstancow":        { bg: "/panel-fuel.png",       color: "#ec7f24" },
  "jg-wroclawska":        { bg: "/panel-catalysts.png",  color: "#efba1c" },
  "zabkowice-wroclawska": { bg: "/panel-scrap.png",      color: "#646464" },
};
---

<Layout
  title="ALNIKO - skład opału, skup złomu, zakuwanie węży hydraulicznych, skup katalizatorów"
  description="ALNIKO działa w Jeleniej Górze i Ząbkowicach Śląskich: skup złomu, skład opału, zakuwanie węży hydraulicznych i skup katalizatorów."
  hideHeader={true}
  hideFooter={true}
>
  <main>
    <section class="hero" aria-label="ALNIKO">

      <!-- Slideshow -->
      <div class="slideshow">
        {services.map((service, i) => (
          <div
            class="slide"
            style={`--slide-bg: url('${service.panelBg}'); animation-delay: ${i * 5}s;`}
          >
            <div class="slide-title-wrap">
              <h2 class="slide-title">{service.name}</h2>
            </div>
          </div>
        ))}
      </div>

      <!-- Overlay gradient -->
      <div class="hero-overlay" aria-hidden="true" />

      <!-- Header bar -->
      <div class="hero-bar">
        <a href="/" class="hero-bar-brand">
          <img src="/alniko.webp" alt="ALNIKO" class="hero-bar-logo" width="180" height="58" />
        </a>
        <nav class="hero-bar-nav" aria-label="Nawigacja główna">
          <a href="#lokalizacje">Nasze lokalizacje</a>
          <a href="#o-nas">O nas</a>
          <a href="#kontakt">Kontakt</a>
        </nav>
        <!-- FB icon inside bar — visible only when sticky -->
        <a
          href="https://www.facebook.com/opalalniko"
          class="hero-fb-inner"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="ALNIKO na Facebooku"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
          </svg>
        </a>
      </div>

      <!-- Facebook icon (outside bar, right side — visible in hero only) -->
      <a
        href="https://www.facebook.com/opalalniko"
        class="hero-fb"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ALNIKO na Facebooku"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
        </svg>
      </a>

      <!-- Location tiles (bottom) -->
      <div class="hero-tiles" id="lokalizacje">
        {allLocations.map((loc, i) => {
          const style = locationStyles[loc.id] ?? { bg: "/panel-scrap.png", color: "#646464" };
          return (
            <a
              href="#kontakt"
              class="hero-tile"
              style={`--tile-color: ${style.color}; --tile-bg: url('${style.bg}'); animation-delay: ${0.3 + i * 0.22}s;`}
              data-loc-id={loc.id}
              aria-label={`${loc.city}, ${loc.address}`}
            >
              <span class="tile-city">{loc.city}</span>
              <span class="tile-address">{loc.postcode} {loc.address}</span>
              <div class="tile-svcs">
                {(loc.services as string[]).map(slug => {
                  const svc = serviceMap[slug as keyof typeof serviceMap];
                  return svc ? (
                    <span class="tile-svc-tag" style={`--tag-color: ${svc.color};`}>{svc.shortName}</span>
                  ) : null;
                })}
              </div>
            </a>
          );
        })}
      </div>

    </section>

    <!-- O nas -->
    <section id="o-nas" class="about-section">
      <div class="about-container">

        <div class="about-header">
          <a href="/">
            <img src="/alniko.webp" alt="Alniko Skład Opału Jelenia Góra" class="about-logo" />
          </a>
        </div>

        <div class="about-main">

          <div class="about-awards">
            <a href="https://www.orlyhandlu.pl/profile-362918-cmp/" target="_blank" rel="noopener noreferrer" class="award-link" aria-label="Orły Handlu 2025 – Laureat Konkursu">
              <img src="https://www.orlyhandlu.pl/images/projectImages/app_logo_for_customer_2025_240.png" alt="Orły Handlu 2025 – Laureat Konkursu" class="award-img" />
            </a>
            <a href="https://www.orlyhandlu.pl/profile-362918-cmp/" target="_blank" rel="noopener noreferrer" class="award-link" aria-label="Orły Handlu – Laureat Plebiscytu">
              <img src="https://www.orlyhandlu.pl/images/medals/laureat300_black_2_pl.png" alt="Orły Handlu – Laureat Plebiscytu" class="award-img" />
            </a>
            <a href="https://www.orlyhandlu.pl/profile-362918-cmp/" target="_blank" rel="noopener noreferrer" class="award-link" aria-label="Orły Handlu 2021 – Laureat Konkursu">
              <img src="http://opal.alniko.eu/thumbs/handlu-2021-logo-1500-3.jpg" alt="Orły Handlu 2021 – Laureat Konkursu" class="award-img" />
            </a>
          </div>

          <div class="about-body">
            <p class="about-tagline">Niech komfort ogrzewania będzie lepszy!<br/>Najwyższa jakość w najniższej cenie!</p>
            <p>Jesteśmy składem węgla w Jeleniej Górze otwartym od 2018 roku, naszym celem jest zapewnienie klientom najlepszej jakości opału w najniższej cenie.</p>
            <p>Chcemy się rozwijać i poszerzać nasz asortyment o produkty, których Państwo szukają. Jesteśmy chętni do współpracy z klientem i szybkiej realizacji usług.</p>
            <p>Oferujemy transport zakupionego towaru we wskazane miejsce o umówionej porze dnia. Szczegóły dotyczące transportu znajdują się w zakładce oferta.</p>
            <p>Jesteśmy dostępni dla Państwa drogą e-mail, jak i na portalu społecznościowym <a href="https://www.facebook.com/opalalniko" target="_blank" rel="noopener noreferrer">Facebook.com&nbsp;@opalalniko</a> poprzez który można się z nami kontaktować i liczyć na szybką odpowiedź oraz pod numerem telefonu <a href="tel:519411866">519&nbsp;411&nbsp;866</a>.</p>
            <div class="about-sign">
              <p class="about-sign-invite">Zapraszamy już dziś</p>
              <p class="about-sign-name">Barbara i Dawid Łukasiewicz</p>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- Service sections -->
    {services.map((service, i) => (
      <section
        id={`service-${service.slug}`}
        class="svc-section"
        style={`--svc-color: ${service.color};`}
      >
        <div class:list={["svc-container", i % 2 === 1 && "svc-reverse"]}>

          <div class="svc-text svc-slide svc-slide-left">
            <span class="svc-eyebrow">{service.shortName}</span>
            <h2 class="svc-title">{service.name}</h2>
            <div class="svc-desc" set:html={service.description} />
            <a href={service.path} class="svc-cta">{service.ctaLabel}</a>
          </div>

          <div class="svc-gallery svc-slide svc-slide-right">
            {serviceGallery[service.slug]?.map((img, gi) => (
              <button
                class="gallery-thumb"
                data-src={img}
                data-gallery={service.slug}
                data-index={gi}
                aria-label={`${service.name} – zdjęcie ${gi + 1}`}
              >
                <img src={img} alt={`${service.name} – zdjęcie ${gi + 1}`} loading="lazy" />
                <span class="gallery-zoom" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                    <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2"/>
                    <path d="m21 21-4.35-4.35M11 8v6M8 11h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  </svg>
                </span>
              </button>
            ))}
          </div>

        </div>
      </section>
    ))}

    <!-- Kontakt -->
    <section id="kontakt" class="contact-section">
      <div class="contact-container">

        <div class="contact-header">
          <h2 class="contact-title">Kontakt</h2>
          <p class="contact-intro">
            Skontaktuj się z nami telefonicznie lub odwiedź wybraną lokalizację.
            Aktualności publikujemy również na
            <a href="https://www.facebook.com/opalalniko" target="_blank" rel="noopener noreferrer">Facebooku&nbsp;@opalalniko</a>.
          </p>
        </div>

          <div class="contact-cards">
            {allLocations.map(loc => (
              <div
                class="contact-card"
                data-lat={loc.lat}
                data-lng={loc.lng}
                data-id={loc.id}
                role="button"
                tabindex="0"
                aria-label={`${loc.city}, ${loc.address}`}
              >
                <div class="contact-card-header">
                  <span class="contact-city">{loc.city}</span>
                  <a
                    href={`tel:${loc.phone.replace(/\s/g, '')}`}
                    class="contact-phone"
                    aria-label={`Zadzwoń: ${loc.phone}`}
                    onclick="event.stopPropagation()"
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.06 6.06l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    {loc.phone}
                  </a>
                </div>
                <p class="contact-address">{loc.postcode}&nbsp;{loc.address}</p>
                <div class="contact-tags">
                  {(loc.services as string[]).map(slug => {
                    const svc = serviceMap[slug as keyof typeof serviceMap];
                    return svc ? (
                      <span class="contact-tag" style={`--tag-color: ${svc.color};`}>{svc.shortName}</span>
                    ) : null;
                  })}
                </div>
                <a
                  href={`https://www.google.com/maps/dir/?api=1&destination=${loc.lat},${loc.lng}`}
                  class="contact-navigate"
                  target="_blank"
                  rel="noopener noreferrer"
                  onclick="event.stopPropagation()"
                >
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                    <circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="2"/>
                  </svg>
                  Nawiguj
                </a>
              </div>
            ))}
          </div>

        <div class="contact-map-wrap">
          <div id="contact-map"></div>
        </div>

      </div>
    </section>

    <!-- Lightbox -->
    <div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Podgląd zdjęcia" hidden>
      <button class="lb-close" id="lb-close" aria-label="Zamknij">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M18 6 6 18M6 6l12 12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
      </button>
      <button class="lb-nav lb-prev" id="lb-prev" aria-label="Poprzednie zdjęcie">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none"><path d="m15 18-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <img id="lb-img" src="" alt="" class="lb-img" />
      <button class="lb-nav lb-next" id="lb-next" aria-label="Następne zdjęcie">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none"><path d="m9 18 6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>

  </main>
</Layout>

<style>
  /* ---- Reset & base ---- */
  * { box-sizing: border-box; margin: 0; padding: 0; }

  /* ---- Hero ---- */
  .hero {
    height: 100vh;
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  /* ---- Slideshow ---- */
  .slideshow {
    height: 100%;
    inset: 0;
    position: absolute;
    width: 100%;
  }

  .slide {
    animation: slide-show 20s infinite;
    animation-fill-mode: backwards;
    display: flex;
    flex-direction: column;
    inset: 0;
    opacity: 0;
    overflow: hidden;
    position: absolute;
    transition: none;
    z-index: 0;
  }

  /* Background lives here so Ken Burns doesn't affect content */
  .slide::before {
    animation: kb-zoom-in 14s ease-in-out infinite alternate;
    background-image: var(--slide-bg);
    background-position: center;
    background-size: cover;
    content: '';
    inset: -4%;
    position: absolute;
    z-index: 0;
  }

  .slide:nth-child(2)::before {
    animation-name: kb-pan-right;
    animation-duration: 18s;
  }

  .slide:nth-child(3)::before {
    animation-name: kb-zoom-out;
    animation-duration: 12s;
  }

  .slide:nth-child(4)::before {
    animation-name: kb-drift-left;
    animation-duration: 16s;
  }

  @keyframes kb-zoom-in {
    from { transform: scale(1); }
    to   { transform: scale(1.06); }
  }

  @keyframes kb-pan-right {
    from { transform: scale(1.04) translateX(-1.5%); }
    to   { transform: scale(1.04) translateX(1.5%); }
  }

  @keyframes kb-zoom-out {
    from { transform: scale(1.06); }
    to   { transform: scale(1); }
  }

  @keyframes kb-drift-left {
    from { transform: scale(1.04) translateX(1.5%); }
    to   { transform: scale(1.04) translateX(-1.5%); }
  }

  @keyframes slide-show {
    0%   { opacity: 0; }
    8%   { opacity: 1; }
    25%  { opacity: 1; }
    33%  { opacity: 0; }
    100% { opacity: 0; }
  }

  /* ---- Slide content ---- */

  .slide-title-wrap {
    align-items: center;
    display: flex;
    flex: 1;
    justify-content: center;
    padding: 6rem 5vw 20%;
    position: relative;
    z-index: 1;
  }

  .slide-title {
    color: #fff;
    font-size: clamp(2.2rem, 4.3vw, 3.9rem);
    font-weight: 900;
    letter-spacing: 0.06em;
    line-height: 1.1;
    margin: 0;
    text-align: center;
    text-shadow: 0 2px 28px rgba(0, 0, 0, 0.75);
    text-transform: uppercase;
  }

  .slide-locs { display: none; }

  /* ---- Overlay ---- */
  .hero-overlay {
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.35) 0%,
      rgba(0, 0, 0, 0.15) 55%,
      rgba(0, 0, 0, 0.55) 100%
    );
    inset: 0;
    position: absolute;
    z-index: 1;
  }

  /* ---- Header bar ---- */
  .hero-bar {
    align-items: center;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.18);
    display: flex;
    gap: 2rem;
    height: 80px;
    left: 0;
    padding: 0 2.5rem;
    position: absolute;
    top: 100px;
    width: 75%;
    z-index: 10;
  }

  /* Transition on the bar itself */
  .hero-bar {
    transition: width 0.4s cubic-bezier(0.22, 1, 0.36, 1),
                box-shadow 0.3s ease;
  }

  /* Sticky state — triggered by JS exactly when bar top = viewport top */
  .hero-bar.is-sticky {
    background: #fff;
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.13);
    height: 68px;
    left: 0;
    position: fixed;
    top: 0;
    width: 100%;
  }

  /* FB icon inside bar */
  .hero-fb-inner {
    color: #1877f2;
    display: flex;
    flex-shrink: 0;
    line-height: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease, transform 0.2s ease;
  }

  .hero-fb-inner:hover { transform: scale(1.12); }

  .hero-bar.is-sticky .hero-fb-inner {
    opacity: 1;
    pointer-events: auto;
  }

  .hero-bar-brand {
    flex-shrink: 0;
    line-height: 0;
  }

  .hero-bar-logo {
    height: 46px;
    object-fit: contain;
    width: auto;
  }

  .hero-bar-nav {
    align-items: center;
    display: flex;
    flex: 1;
    gap: 2rem;
    justify-content: center;
  }

  .hero-bar-nav a {
    color: #1a1a1a;
    font-family: var(--font-title);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }

  .hero-bar-nav a:hover {
    color: var(--color-accent);
  }

  /* Facebook icon — outside bar, right side */
  .hero-fb {
    color: #fff;
    line-height: 0;
    position: absolute;
    right: 20px;
    top: 100px;
    transform: translateY(calc(80px / 2 - 13px)); /* vertically center with bar */
    transition: color 0.2s ease, transform 0.2s ease;
    z-index: 11;
  }

  .hero-fb:hover {
    color: #e0e0e0;
    transform: translateY(calc(80px / 2 - 13px)) scale(1.15);
  }

  /* ---- Service tiles ---- */
  .hero-tiles {
    bottom: 0;
    display: flex;
    height: 25%;
    left: 0;
    position: absolute;
    width: 100%;
    z-index: 5;
  }

  @keyframes tile-fadein {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-tile {
    align-items: center;
    animation: tile-fadein 0.65s ease forwards;
    background-image: var(--tile-bg);
    background-position: center;
    background-size: cover;
    clip-path: polygon(16px 0%, 100% 0%, calc(100% - 16px) 100%, 0% 100%);
    color: #fff;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.85rem;
    justify-content: center;
    opacity: 0;
    overflow: hidden;
    padding: 1.5rem 1.5rem;
    position: relative;
    text-decoration: none;
    transition: transform 0.3s ease;
  }

  /* Overlap to close gaps */
  .hero-tile:not(:first-child) {
    margin-left: -16px;
  }

  /* Stacking: each tile on top of the previous */
  .hero-tile:nth-child(1) { z-index: 1; }
  .hero-tile:nth-child(2) { z-index: 2; }
  .hero-tile:nth-child(3) { z-index: 3; }

  /* First tile: straight left edge */
  .hero-tile:first-child {
    clip-path: polygon(0 0%, 100% 0%, calc(100% - 16px) 100%, 0% 100%);
  }

  /* Last tile: straight right edge */
  .hero-tile:last-child {
    clip-path: polygon(16px 0%, 100% 0%, 100% 100%, 0% 100%);
  }

  /* Color overlay */
  .hero-tile::before {
    background: color-mix(in srgb, var(--tile-color), black 30%);
    content: '';
    inset: 0;
    opacity: 0.88;
    position: absolute;
    transition: opacity 0.3s ease;
    z-index: 0;
  }

  /* Top shimmer line */
  .hero-tile::after {
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.22), transparent);
    content: '';
    height: 1px;
    left: 0;
    position: absolute;
    top: 0;
    transform: scaleX(0);
    transition: transform 0.4s ease;
    width: 100%;
    z-index: 1;
  }

  .hero-tile:hover {
    transform: translateY(-6px);
    z-index: 10;
  }

  .hero-tile:hover::before {
    opacity: 0.65;
  }

  .hero-tile:hover::after {
    transform: scaleX(1);
  }

  .hero-tile > * {
    position: relative;
    z-index: 1;
  }

  .tile-city {
    font-family: var(--font-title);
    font-size: clamp(1rem, 1.6vw, 1.4rem);
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1.1;
    text-align: center;
    text-shadow: 0 2px 10px rgba(0,0,0,0.65);
    text-transform: uppercase;
  }

  .tile-address {
    font-size: clamp(0.68rem, 1vw, 0.88rem);
    font-weight: 500;
    letter-spacing: 0.03em;
    opacity: 0.88;
    text-align: center;
    text-shadow: 0 1px 6px rgba(0,0,0,0.55);
  }

  .tile-svcs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    justify-content: center;
    margin-top: 0.15rem;
  }

  .tile-svc-tag {
    background: color-mix(in srgb, var(--tag-color) 55%, transparent);
    border: 1px solid color-mix(in srgb, var(--tag-color) 75%, white 25%);
    clip-path: polygon(0 0, calc(100% - 6px) 0, 100% 6px, 100% 100%, 6px 100%, 0 calc(100% - 6px));
    font-size: clamp(0.58rem, 0.85vw, 0.72rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.55rem;
    text-align: center;
    text-shadow: 0 1px 4px rgba(0,0,0,0.4);
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .hero-bar {
      height: 68px;
      top: 60px;
      width: 90%;
    }

    .hero-bar-nav {
      gap: 1.25rem;
    }

