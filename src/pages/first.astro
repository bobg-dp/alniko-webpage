---
import Layout from "../layouts/Layout.astro";
import { locations, siteConfig } from "../config/site";
import { services } from "../config/services";

const iconMap: Record<string, string> = {
  scrap: "/icons/recycle.webp",
  fuel: "/icons/fire.webp",
  hoses: "/icons/pipe.webp",
  catalysts: "/icons/cat.webp",
};

const bgMap: Record<string, string> = {
  scrap: "/panel-scrap.png",
  fuel: "/fuel-bg.png",
  hoses: "/panel-hoses.png",
  catalysts: "/catalysts-bg.png",
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      name: siteConfig.companyName,
      url: siteConfig.siteUrl,
      logo: `${siteConfig.siteUrl}/alniko.webp`,
      sameAs: [siteConfig.social.facebook],
      description:
        "ALNIKO: skład i sprzedaż opału, skup złomu, zakuwanie węży hydraulicznych oraz skup katalizatorów.",
    },
    ...locations.map((location) => ({
      "@type": "LocalBusiness",
      name: `${siteConfig.companyName} - ${location.title}`,
      url: siteConfig.siteUrl,
      telephone: location.phoneLabel,
      address: {
        "@type": "PostalAddress",
        streetAddress: location.address,
      },
    })),
  ],
};
---

<Layout
  title="ALNIKO - skład opału, skup złomu, zakuwanie węży hydraulicznych, skup katalizatorów"
  description="ALNIKO działa w Jeleniej Górze i Ząbkowicach Śląskich: skup złomu, skład opału, zakuwanie węży hydraulicznych i skup katalizatorów."
>
  <main>
    <section class="hero" aria-label="Nagłówek strony firmy ALNIKO">
      <img src="/head2.webp" alt="ALNIKO - główna grafika przedstawiająca działalność firmy" width="1920" height="700" />
      <canvas class="hero-dots" aria-hidden="true"></canvas>
      <div class="hero-content">
        <span class="hero-logo-wrap">
          <span class="hero-logo-panel" />
          <img class="hero-logo" src="/alniko.webp" alt="ALNIKO" width="280" height="90" />
        </span>
        <div class="hero-tiles">
          {services.map((service) => (
            <a class="hero-tile" href={`#${service.slug}`} style={`--tile-color: ${service.color};`}>
              <span class="hero-tile-inner">
                <span class="hero-tile-bg" />
                <img class="hero-icon" src={iconMap[service.slug]} alt="" width="64" height="64" />
              </span>
              <span class="hero-tile-label">{service.heroLabel}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    {services.map((service) => {
      const serviceLocations = locations.filter(loc => loc.services.includes(service.slug));
      const otherServices = services.filter(s => s.slug !== service.slug);

      return (
        <section id={service.slug} class="service-section has-deco" style={`--section-color: ${service.color};`}>
          <div class="service-section-inner">

            <div class="service-panel">
              <span class="service-panel-bg" />
              <img class="service-panel-icon" src={iconMap[service.slug]} alt="" width="128" height="128" />
              <span class="service-panel-label">{service.name}</span>
            </div>

            <div class="service-content">
              <div class="service-text">
                <h2>{service.name}</h2>
                <p>
                  Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
                </p>
                <p>
                  Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.
                </p>
              </div>

              {serviceLocations.length > 0 && (
                <div class="service-locations">
                  <h3>Lokalizacje</h3>
                  {serviceLocations.map(loc => (
                    <div class="service-location-item">
                      <p class="location-address">{loc.address}</p>
                      <p class="location-phone">
                        Tel: <a href={loc.phoneHref}>{loc.phoneLabel}</a>
                      </p>
                    </div>
                  ))}
                </div>
              )}

              <nav class="service-nav" aria-label={`Przejdź do: inne działalności`}>
                {otherServices.map(other => (
                  <a href={`#${other.slug}`} class="service-nav-link" style={`--nav-color: ${other.color};`}>
                    <img src={iconMap[other.slug]} alt="" width="20" height="20" />
                    <span>{other.heroLabel}</span>
                  </a>
                ))}
              </nav>
            </div>

          </div>

          <img class="service-deco" src={bgMap[service.slug]} alt="" width="700" height="467" />
        </section>
      );
    })}
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Layout>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.hero-dots');
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const GAP = 6;
    const BASE_R = 3;
    const PUSH_RADIUS = 120;
    const PUSH_STRENGTH = 8;
    const LERP = 0.08;

    let mouse = { x: -9999, y: -9999 };
    let cols = 0;
    let rows = 0;

    interface Dot { bx: number; by: number; dx: number; dy: number }
    let dots: Dot[] = [];

    function resize() {
      const rect = canvas!.getBoundingClientRect();
      canvas!.width = rect.width * devicePixelRatio;
      canvas!.height = rect.height * devicePixelRatio;
      ctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);

      cols = Math.ceil(rect.width / GAP) + 1;
      rows = Math.ceil(rect.height / GAP) + 1;
      dots = [];
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          dots.push({ bx: c * GAP, by: r * GAP, dx: 0, dy: 0 });
        }
      }
    }

    function draw() {
      const w = canvas!.getBoundingClientRect().width;
      const h = canvas!.getBoundingClientRect().height;
      ctx.clearRect(0, 0, w, h);

      for (const dot of dots) {
        const diffX = dot.bx + dot.dx - mouse.x;
        const diffY = dot.by + dot.dy - mouse.y;
        const dist = Math.sqrt(diffX * diffX + diffY * diffY);

        let targetDx = 0;
        let targetDy = 0;

        if (dist < PUSH_RADIUS && dist > 0) {
          const force = (1 - dist / PUSH_RADIUS) * PUSH_STRENGTH;
          targetDx = (diffX / dist) * force;
          targetDy = (diffY / dist) * force;
        }

        dot.dx += (targetDx - dot.dx) * LERP;
        dot.dy += (targetDy - dot.dy) * LERP;

        const x = dot.bx + dot.dx;
        const y = dot.by + dot.dy;
        const displacement = Math.sqrt(dot.dx * dot.dx + dot.dy * dot.dy);
        const alpha = 0.3 + Math.min(displacement / PUSH_STRENGTH, 1) * 0.35;

        ctx.beginPath();
        ctx.arc(x, y, BASE_R, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(0,0,0,${alpha})`;
        ctx.fill();
      }

      requestAnimationFrame(draw);
    }

    const hero = canvas!.closest('.hero')!;
    hero.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = canvas!.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
    });

    hero.addEventListener('mouseleave', () => {
      mouse.x = -9999;
      mouse.y = -9999;
    });

    resize();
    window.addEventListener('resize', resize);
    requestAnimationFrame(draw);
  }
</script>

<style>
  .hero {
    height: 100vh;
    position: relative;
  }

  .hero > img {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .hero-content {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: 2.4rem;
    left: 50%;
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
  }

  .hero-dots {
    height: 100%;
    left: 0;
    pointer-events: none;
    position: absolute;
    top: 0;
    width: 100%;
    z-index: 1;
  }

  .hero-logo-wrap {
    align-items: center;
    display: flex;
    justify-content: center;
    padding: 2rem 3rem;
    position: relative;
    z-index: 1;
  }

  .hero-logo-panel {
    background: linear-gradient(145deg, rgba(30, 30, 30, 0.9), rgba(20, 20, 20, 0.95));
    border: 1px solid rgba(236, 127, 36, 0.3);
    display: block;
    inset: 0;
    position: absolute;
    transform: skewX(-8deg);
  }

  .hero-logo {
    animation: logoPulse 3s ease-in-out infinite;
    height: auto;
    max-width: 420px;
    position: relative;
    width: 100%;
    z-index: 1;
  }

  @keyframes logoPulse {
    0%, 100% {
      filter: drop-shadow(0 0 6px rgba(236, 127, 36, 0.2));
      transform: scale(1);
    }
    50% {
      filter: drop-shadow(0 0 16px rgba(236, 127, 36, 0.4));
      transform: scale(1.02);
    }
  }

  .hero-tiles {
    display: flex;
    flex-direction: row;
    gap: 24px;
    position: relative;
    z-index: 1;
  }

  .hero-tile {
    align-items: center;
    color: var(--color-white);
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    position: relative;
    text-decoration: none;
    width: 200px;
  }

  .hero-tile-inner {
    align-items: center;
    aspect-ratio: 1 / 1.15;
    display: flex;
    justify-content: center;
    padding: 1rem;
    position: relative;
    width: 100%;
  }

  .hero-tile-bg {
    background: var(--tile-color);
    display: block;
    inset: 0;
    position: absolute;
    transform: skewX(-8deg);
    transition: filter 0.25s ease, transform 0.25s ease;
  }

  .hero-tile:hover .hero-tile-bg {
    filter: brightness(1.18);
    transform: skewX(-8deg) scaleY(1.04);
  }

  .hero-icon {
    flex-shrink: 0;
    height: 70%;
    object-fit: contain;
    position: relative;
    width: 70%;
    z-index: 1;
  }

  .hero-tile-label {
    font-family: var(--font-title);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    position: relative;
    text-align: center;
    text-shadow: 0 2px 6px rgb(0 0 0 / 0.6);
    text-transform: uppercase;
    z-index: 1;
  }

  @media (max-width: 1100px) {
    .hero-tile {
      width: 150px;
    }

    .hero-tile-label {
      font-size: 0.9rem;
    }
  }

  @media (max-width: 680px) {
    .hero-content {
      gap: 1.4rem;
    }

    .hero-logo-wrap {
      padding: 1.2rem 1.8rem;
    }

    .hero-logo {
      max-width: 260px;
    }

    .hero-tiles {
      gap: 12px;
    }

    .hero-tile {
      width: 100px;
    }

    .hero-tile-inner {
      padding: 0.6rem;
    }

    .hero-tile-label {
      font-size: 0.65rem;
    }
  }

  /* --- Service Sections --- */

  .service-section {
    align-items: center;
    display: flex;
    min-height: 100vh;
    padding: 4rem 2rem;
    position: relative;
  }

  .service-section:nth-child(even) {
    background: rgba(0, 0, 0, 0.15);
  }

  .service-section-inner {
    align-items: center;
    display: grid;
    gap: 3rem;
    grid-template-columns: 280px 1fr;
    margin: 0 auto;
    max-width: 1200px;
    width: 100%;
  }

  .service-panel {
    align-items: center;
    aspect-ratio: 1 / 1.15;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    width: 100%;
  }

  .service-panel-bg {
    background: var(--section-color);
    display: block;
    inset: 0;
    position: absolute;
    transform: skewX(-8deg);
  }

  .service-panel-icon {
    height: 55%;
    object-fit: contain;
    position: relative;
    width: 55%;
    z-index: 1;
  }

  .service-panel-label {
    color: var(--color-white);
    font-family: var(--font-title);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    margin-top: 1rem;
    position: relative;
    text-align: center;
    text-transform: uppercase;
    z-index: 1;
  }

  .service-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .service-text h2 {
    color: var(--color-white);
    font-size: 1.8rem;
    margin-bottom: 1rem;
    margin-top: 0;
  }

  .service-text h2::first-letter {
    color: var(--color-accent);
  }

  .service-text p {
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.7;
    margin: 0 0 0.8rem;
  }

  .service-locations {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-top: 1.5rem;
  }

  .service-locations h3 {
    font-size: 1rem;
    margin: 0 0 1rem;
    text-transform: uppercase;
  }

  .service-location-item {
    margin-bottom: 1rem;
  }

  .service-location-item p {
    margin: 0;
  }

  .location-address {
    color: rgba(255, 255, 255, 0.8);
    font-weight: 500;
  }

  .location-phone a {
    color: var(--color-accent);
    font-weight: 700;
    text-decoration: none;
  }

  .location-phone a:hover {
    text-decoration: underline;
  }

  .service-nav {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 1.5rem;
  }

  .service-nav-link {
    align-items: center;
    background: var(--nav-color);
    color: var(--color-white);
    display: flex;
    font-size: 0.85rem;
    font-weight: 600;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    text-decoration: none;
    transform: skewX(-4deg);
    transition: filter 0.2s ease, transform 0.2s ease;
  }

  .service-nav-link:hover {
    filter: brightness(1.25);
    transform: skewX(-4deg) scale(1.05);
  }

  .service-nav-link img {
    height: 20px;
    object-fit: contain;
    width: 20px;
  }

  /* Decorative background image (Fuchs excavator) */

  .service-section.has-deco {
    overflow: hidden;
  }

  .service-deco {
    height: 100%;
    left: 50%;
    object-fit: contain;
    opacity: 0.15;
    pointer-events: none;
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    z-index: 0;
  }

  .service-section.has-deco .service-section-inner {
    position: relative;
    z-index: 1;
  }

  @media (max-width: 900px) {
    .service-section-inner {
      gap: 2rem;
      grid-template-columns: 200px 1fr;
    }

    .service-panel-label {
      font-size: 0.9rem;
    }

    .service-text h2 {
      font-size: 1.4rem;
    }
  }

  @media (max-width: 680px) {
    .service-section {
      padding: 3rem 1rem;
    }

    .service-section-inner {
      gap: 2rem;
      grid-template-columns: 1fr;
    }

    .service-panel {
      margin: 0 auto;
      max-width: 180px;
    }

    .service-nav {
      justify-content: center;
    }

    .service-deco {
      opacity: 0.12;
    }
  }
</style>
