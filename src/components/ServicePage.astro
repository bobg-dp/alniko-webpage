---
import { Icon } from "astro-icon/components";
import type { ServiceDefinition } from "../config/services";
import { servicePagesCommon } from "../config/services";
import siteData from "../config/site-data.json";
import SiteNav from "./SiteNav.astro";
import SiteFooter from "./SiteFooter.astro";
import ServiceSideNav from "./ServiceSideNav.astro";

interface Props {
  service: ServiceDefinition;
}

const { service } = Astro.props;
const common = servicePagesCommon;
const serviceLocations = siteData.locations.filter((location) =>
  (location.services as string[]).includes(service.slug),
);
const offerPoints = service.page.offerPoints;
const highlights = service.highlights ?? [];
const wholesalePoints = service.page.wholesalePoints ?? [];
const wholesaleTitle = service.page.wholesaleTitle ?? common.wholesaleTitle;
---

<SiteNav alwaysSticky={true} homeLinks={true} showHome={true} />
<ServiceSideNav />

<main class="service-page">
  <div class="service-main">
    <section class="service-hero" style={`--service-color: ${service.color};`}>
      <div class="service-hero-inner">
        <h1 class="section-title">{service.page.h1}</h1>
        <p>{service.page.heroIntro}</p>
      </div>
    </section>

    <section id="lokalizacje" class="content-section">
      <h2 class="section-title">{common.locationsTitle}</h2>
      <div class="location-grid">
        {
          serviceLocations.map((location) => (
            <article class="location-card">
              <div class="location-card-top">
                <h3>{location.city}</h3>
                <p class="location-services">{location.title}</p>
                <p class="location-address">{location.postcode} {location.address}</p>
              </div>
              <div class="location-card-actions">
                <p class="location-phone">
                  {common.contactLabel}{" "}
                  <a href={`tel:${location.phone.replace(/\s/g, "")}`}>{location.phone}</a>
                </p>
                <a
                  href={`https://www.google.com/maps/dir/?api=1&destination=${location.lat},${location.lng}`}
                  class="location-navigate"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                    <circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="2"/>
                  </svg>
                  {common.navigateLabel}
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section id="godziny-otwarcia" class="content-section">
      <h2 class="section-title">{common.hoursTitle}</h2>
      <p>{common.hoursBody}</p>
    </section>

    <section id="oferta" class="content-section">
      <h2 class="section-title">{service.name}</h2>
      <div class="service-body" set:html={service.description} />

      <h3 class="offer-subtitle">{service.page.offerTitle}</h3>
      {highlights.length > 0 ? (
        <ul class="service-highlights">
          {highlights.map((item) => (
            <li class="service-highlight">
              <Icon name={item.icon} class="service-highlight-icon" aria-hidden="true" />
              <span>{item.text}</span>
            </li>
          ))}
        </ul>
      ) : (
        <ul class="offer-list offer-list--checks">
          {offerPoints.map((point) => <li>{point}</li>)}
        </ul>
      )}
    </section>

    {
      wholesalePoints.length > 0 && (
        <section id="oferta-hurtowa" class="content-section">
          <h2 class="section-title">{wholesaleTitle}</h2>
          <ul class="offer-list">
            {wholesalePoints.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</main>

<SiteFooter homeLinks={true} />

<style>
  .service-page {
    background: #0c0c0c;
    min-height: 100vh;
    padding: 5.5rem 0 4rem;
  }

  .service-main {
    margin: 0 auto;
    max-width: 1100px;
    padding: 0 4.5rem 0 1.5rem;
  }

  .service-hero {
    background: linear-gradient(130deg, var(--service-color), color-mix(in srgb, var(--service-color), black 30%));
    border-radius: 0.4rem;
    padding: 2rem 1.4rem;
  }

  .service-hero-inner {
    max-width: 720px;
  }

  .service-hero p {
    margin-bottom: 0;
  }

  .content-section {
    margin-top: 2.5rem;
  }

  .location-grid {
    align-items: stretch;
    display: grid;
    gap: 0.9rem;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  }

  .location-card {
    border: 1px solid color-mix(in srgb, var(--color-white), transparent 70%);
    border-radius: 0.4rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1rem;
  }

  .location-card-top {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.35rem;
  }

  .location-card h3 {
    margin: 0;
  }

  .location-services,
  .location-address,
  .location-phone {
    margin: 0;
  }

  .location-services {
    color: color-mix(in srgb, var(--color-white), transparent 25%);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .location-address {
    line-height: 1.45;
  }

  .location-card-actions {
    border-top: 1px solid color-mix(in srgb, var(--color-white), transparent 85%);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1rem;
    padding-top: 0.85rem;
  }

  .location-phone a {
    color: var(--color-accent);
    font-weight: 700;
    text-decoration: none;
  }

  .location-navigate {
    align-items: center;
    background: var(--color-accent);
    clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px));
    color: #fff;
    display: inline-flex;
    font-family: var(--font-title);
    font-size: 0.68rem;
    font-weight: 700;
    gap: 0.4rem;
    justify-content: center;
    letter-spacing: 0.08em;
    padding: 0.65rem 0.9rem;
    text-decoration: none;
    text-transform: uppercase;
    transition: opacity 0.2s ease, transform 0.2s ease;
    width: fit-content;
  }

  .location-navigate:hover {
    opacity: 0.88;
    transform: translateY(-1px);
  }

  .service-body {
    color: color-mix(in srgb, var(--color-white), transparent 12%);
    font-size: 0.97rem;
    line-height: 1.78;
    max-width: 70ch;
  }

  .service-body :global(p) {
    margin: 0 0 1rem;
  }

  .service-body :global(ul) {
    margin: 0 0 1rem;
    padding-left: 1.2rem;
  }

  .service-body :global(li) {
    margin-bottom: 0.35rem;
  }

  .service-body :global(strong) {
    color: var(--color-white);
    font-weight: 700;
  }

  .offer-subtitle {
    font-family: var(--font-title);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin: 1.75rem 0 0.85rem;
    text-transform: uppercase;
  }

  .offer-list {
    display: grid;
    gap: 0.4rem;
    padding-left: 1.1rem;
  }

  .offer-list--checks {
    list-style: none;
    padding-left: 0;
  }

  .offer-list--checks li {
    padding-left: 1.6rem;
    position: relative;
  }

  .offer-list--checks li::before {
    color: var(--color-accent);
    content: "✓";
    font-weight: 700;
    left: 0;
    position: absolute;
  }

  .service-highlights {
    display: grid;
    gap: 0.48rem 0.9rem;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    list-style: none;
    margin: 0;
    max-width: 720px;
    padding: 0;
  }

  .service-highlight {
    align-items: center;
    color: color-mix(in srgb, var(--color-white), transparent 12%);
    display: flex;
    font-size: 0.86rem;
    font-weight: 600;
    gap: 0.54rem;
    line-height: 1.3;
  }

  .service-highlight-icon {
    color: var(--color-accent);
    flex-shrink: 0;
    height: 1.2rem;
    width: 1.2rem;
  }

  @media (max-width: 820px) {
    .service-page {
      padding-bottom: 5.5rem;
    }

    .service-main {
      padding: 0 1.25rem;
    }
  }

  @media (max-width: 600px) {
    .service-page {
      padding-top: 6rem;
    }
  }
</style>
