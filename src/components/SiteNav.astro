---
/**
 * Reusable sticky top navigation bar.
 * Props:
 *   alwaysSticky  – if true the bar is immediately fixed (e.g. subpages without a hero).
 *                   if false (default) the bar starts positioned inside the hero and becomes
 *                   sticky on scroll (index.astro controls this via JS + .is-sticky class).
 *   homeLinks     – if true nav links use absolute URLs like /#o-nas (for subpages).
 *                   if false (default) links are hash-only (#o-nas) (for the main page).
 *   showHome      – if true adds "Strona główna" as the first nav item (for subpages).
 */
interface Props {
  alwaysSticky?: boolean;
  homeLinks?: boolean;
  showHome?: boolean;
}

const { alwaysSticky = false, homeLinks = false, showHome = false } = Astro.props;
const prefix = homeLinks ? '/' : '';
---

<div class:list={["hero-bar", alwaysSticky && "is-sticky is-always-sticky"]}>
  <a href="/" class="hero-bar-brand">
    <img src="/alniko.webp" alt="ALNIKO" class="hero-bar-logo" width="180" height="58" />
  </a>
  <nav class="hero-bar-nav" aria-label="Nawigacja główna">
    {showHome && <a href="/">Strona główna</a>}
    <a href={`${prefix}#lokalizacje`}>Nasze lokalizacje</a>
    <a href={`${prefix}#o-nas`}>O nas</a>
    <a href={`${prefix}#kontakt`}>Kontakt</a>
    <a href={`${prefix}#galeria`}>Galeria</a>
  </nav>
  <a
    href="https://www.facebook.com/opalalniko"
    class="hero-fb-inner"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="ALNIKO na Facebooku"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
    </svg>
  </a>
</div>

<style>
  .hero-bar {
    align-items: center;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.18);
    display: flex;
    gap: 2rem;
    height: 80px;
    left: 0;
    padding: 0 2.5rem;
    position: absolute;
    top: 100px;
    transition: width 0.4s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.3s ease;
    width: 75%;
    z-index: 10;
  }

  .hero-bar.is-sticky {
    background: #fff;
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.13);
    height: 68px;
    left: 0;
    position: fixed;
    top: 0;
    width: 100%;
  }

  .hero-fb-inner {
    color: #1877f2;
    display: flex;
    flex-shrink: 0;
    line-height: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease, transform 0.2s ease;
  }

  .hero-fb-inner:hover { transform: scale(1.12); }

  .hero-bar.is-sticky .hero-fb-inner {
    opacity: 1;
    pointer-events: auto;
  }

  .hero-bar-brand {
    flex-shrink: 0;
    line-height: 0;
  }

  .hero-bar-logo {
    height: 46px;
    object-fit: contain;
    width: auto;
  }

  .hero-bar-nav {
    align-items: center;
    display: flex;
    flex: 1;
    gap: 2rem;
    justify-content: center;
  }

  .hero-bar-nav a {
    color: #1a1a1a;
    font-family: var(--font-title);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }

  .hero-bar-nav a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 900px) {
    .hero-bar {
      height: 68px;
      top: 60px;
      width: 90%;
    }

    .hero-bar-nav {
      gap: 1.25rem;
    }

    .hero-bar-nav a {
      font-size: 0.62rem;
    }
  }

  @media (max-width: 680px) {
    .hero-bar {
      gap: 1rem;
      height: 58px;
      padding: 0 1.25rem;
      top: 40px;
      width: 100%;
    }

    .hero-bar-logo {
      height: 34px;
    }

    .hero-bar-nav {
      display: none;
    }

    .hero-bar.is-sticky {
      height: 58px;
      top: 0;
    }
  }
</style>
