---
/**
 * Reusable sticky top navigation bar.
 * Props:
 *   alwaysSticky  – if true the bar is immediately fixed (e.g. subpages without a hero).
 *                   if false (default) the bar starts positioned inside the hero and becomes
 *                   sticky on scroll (index.astro controls this via JS + .is-sticky class).
 *   homeLinks     – if true nav links use absolute URLs like /#o-nas (for subpages).
 *                   if false (default) links are hash-only (#o-nas) (for the main page).
 *   showHome      – if true adds "Strona główna" as the first nav item (for subpages).
 */
interface Props {
  alwaysSticky?: boolean;
  homeLinks?: boolean;
  showHome?: boolean;
}

const { alwaysSticky = false, homeLinks = false, showHome = false } = Astro.props;
const prefix = homeLinks ? '/' : '';

const navLinks = [
  ...(showHome ? [{ href: '/', label: 'Strona główna' }] : []),
  { href: `${prefix}#lokalizacje`, label: 'Nasze lokalizacje' },
  { href: `${prefix}#o-nas`,       label: 'O nas' },
  { href: `${prefix}#kontakt`,     label: 'Kontakt' },
  { href: `${prefix}#galeria`,     label: 'Galeria' },
];
---

<div class:list={["hero-bar", alwaysSticky && "is-sticky is-always-sticky"]}>
  <a href="/" class="hero-bar-brand">
    <img src="/alniko.webp" alt="ALNIKO" class="hero-bar-logo" width="180" height="58" />
  </a>

  <!-- Desktop nav -->
  <nav class="hero-bar-nav" aria-label="Nawigacja główna">
    {navLinks.map(l => <a href={l.href}>{l.label}</a>)}
  </nav>

  <!-- FB icon (sticky state) -->
  <a
    href="https://www.facebook.com/opalalniko"
    class="hero-fb-inner"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="ALNIKO na Facebooku"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
    </svg>
  </a>

  <!-- Hamburger button (mobile only) -->
  <button class="mob-toggle" id="mob-toggle" aria-label="Otwórz menu" aria-expanded="false" aria-controls="mob-menu">
    <span class="mob-bar"></span>
    <span class="mob-bar"></span>
    <span class="mob-bar"></span>
  </button>
</div>

<!-- Mobile drawer -->
<div class="mob-menu" id="mob-menu" aria-hidden="true">
  <nav aria-label="Menu mobilne">
    {navLinks.map(l => <a href={l.href} class="mob-link">{l.label}</a>)}
    <a href="https://www.facebook.com/opalalniko" class="mob-link mob-fb" target="_blank" rel="noopener noreferrer">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
      </svg>
      Facebook
    </a>
  </nav>
</div>
<!-- Backdrop -->
<div class="mob-backdrop" id="mob-backdrop" aria-hidden="true"></div>

<style>
  /* ---- Bar ---- */
  .hero-bar {
    align-items: center;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.18);
    display: flex;
    gap: 2rem;
    height: 80px;
    left: 0;
    padding: 0 2.5rem;
    position: absolute;
    top: 100px;
    transition: width 0.4s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.3s ease;
    width: 75%;
    z-index: 200;
  }

  .hero-bar.is-sticky {
    background: #fff;
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.13);
    height: 68px;
    left: 0;
    position: fixed;
    top: 0;
    width: 100%;
  }

  /* ---- FB inner icon ---- */
  .hero-fb-inner {
    color: #1877f2;
    display: flex;
    flex-shrink: 0;
    line-height: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease, transform 0.2s ease;
  }
  .hero-fb-inner:hover { transform: scale(1.12); }
  .hero-bar.is-sticky .hero-fb-inner {
    opacity: 1;
    pointer-events: auto;
  }

  /* ---- Brand / logo ---- */
  .hero-bar-brand {
    flex-shrink: 0;
    line-height: 0;
  }

  .hero-bar-logo {
    height: 46px;
    object-fit: contain;
    width: auto;
  }

  /* ---- Desktop nav ---- */
  .hero-bar-nav {
    align-items: center;
    display: flex;
    flex: 1;
    gap: 2rem;
    justify-content: center;
  }

  .hero-bar-nav a {
    color: #1a1a1a;
    font-family: var(--font-title);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }
  .hero-bar-nav a:hover { color: var(--color-accent); }

  /* ---- Hamburger button ---- */
  .mob-toggle {
    align-items: center;
    background: none;
    border: none;
    cursor: pointer;
    display: none;
    flex-direction: column;
    gap: 5px;
    justify-content: center;
    margin-left: auto;
    padding: 8px;
    position: relative;
    z-index: 201;
  }

  .mob-bar {
    background: #111;
    border-radius: 2px;
    display: block;
    height: 2.5px;
    transition: transform 0.3s ease, opacity 0.2s ease;
    width: 24px;
  }

  .mob-toggle[aria-expanded="true"] .mob-bar:nth-child(1) {
    transform: translateY(7.5px) rotate(45deg);
  }
  .mob-toggle[aria-expanded="true"] .mob-bar:nth-child(2) {
    opacity: 0;
  }
  .mob-toggle[aria-expanded="true"] .mob-bar:nth-child(3) {
    transform: translateY(-7.5px) rotate(-45deg);
  }

  /* ---- Mobile drawer ---- */
  .mob-menu {
    background: #fff;
    box-shadow: 4px 0 24px rgba(0,0,0,0.18);
    display: flex;
    flex-direction: column;
    height: 100vh;
    left: 0;
    overflow-y: auto;
    padding: 5rem 0 2rem;
    position: fixed;
    top: 0;
    transform: translateX(-100%);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    width: min(80vw, 300px);
    z-index: 199;
  }

  .mob-menu.is-open {
    transform: translateX(0);
  }

  .mob-menu nav {
    display: flex;
    flex-direction: column;
  }

  .mob-link {
    align-items: center;
    border-bottom: 1px solid rgba(0,0,0,0.06);
    color: #1a1a1a;
    display: flex;
    font-family: var(--font-title);
    font-size: 0.82rem;
    font-weight: 700;
    gap: 0.6rem;
    letter-spacing: 0.08em;
    padding: 1rem 1.75rem;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 0.2s ease, background 0.2s ease;
  }
  .mob-link:hover {
    background: rgba(236,127,36,0.06);
    color: var(--color-accent);
  }

  .mob-fb {
    color: #1877f2;
    margin-top: 0.5rem;
  }
  .mob-fb:hover { color: #1877f2; background: rgba(24,119,242,0.06); }

  /* ---- Backdrop ---- */
  .mob-backdrop {
    background: rgba(0,0,0,0.45);
    inset: 0;
    opacity: 0;
    pointer-events: none;
    position: fixed;
    transition: opacity 0.3s ease;
    z-index: 198;
  }

  .mob-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .hero-bar {
      height: 68px;
      top: 60px;
      width: 90%;
    }

    .hero-bar-nav {
      gap: 1.25rem;
    }

    .hero-bar-nav a {
      font-size: 0.62rem;
    }
  }

  @media (max-width: 680px) {
    .hero-bar {
      gap: 1rem;
      height: 58px;
      padding: 0 1.25rem;
      top: 40px;
      width: 100%;
    }

    .hero-bar-logo {
      height: 34px;
    }

    .hero-bar-nav {
      display: none;
    }

    .hero-fb-inner {
      display: none;
    }

    .mob-toggle {
      display: flex;
    }

    .hero-bar.is-sticky {
      height: 58px;
      top: 0;
    }
  }
</style>

<script is:inline>
(function () {
  var toggle   = document.getElementById('mob-toggle');
  var menu     = document.getElementById('mob-menu');
  var backdrop = document.getElementById('mob-backdrop');
  if (!toggle || !menu || !backdrop) return;

  /* Move drawer & backdrop to <body> so they're never clipped by
     overflow:hidden ancestors (e.g. the hero section). */
  document.body.appendChild(backdrop);
  document.body.appendChild(menu);

  function open() {
    menu.classList.add('is-open');
    backdrop.classList.add('is-open');
    toggle.setAttribute('aria-expanded', 'true');
    toggle.setAttribute('aria-label', 'Zamknij menu');
    menu.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function close() {
    menu.classList.remove('is-open');
    backdrop.classList.remove('is-open');
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Otwórz menu');
    menu.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  toggle.addEventListener('click', function () {
    toggle.getAttribute('aria-expanded') === 'true' ? close() : open();
  });

  backdrop.addEventListener('click', close);

  menu.querySelectorAll('.mob-link').forEach(function (link) {
    link.addEventListener('click', close);
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') close();
  });
})();
</script>
